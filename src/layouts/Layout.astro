---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { FaqItem } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'profile';
  faq?: FaqItem[];
  robots?: string;
}
const { title, description, noindex, type, faq, robots } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="author" content="Sven Mulfinger" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, 'https://mulfinger.com').href} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, 'https://mulfinger.com').href} />
    <Seo title={title} description={description} noindex={noindex} type={type} faq={faq} robots={robots} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] bg-accent text-paper px-4 py-2">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
