---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Chapter from '../components/Chapter.astro';
import Paths from '../components/Paths.astro';
import Invite from '../components/Invite.astro';
import PhotoHero from '../components/PhotoHero.astro';
import bookCover from '../assets/images/book-cover-nonlinear.png';
import heroPhoto from '../assets/images/hero-office.jpg';
import { site, book } from '../data/site';
import { cases } from '../data/cases';
import { testimonials } from '../data/testimonials';
import Voice from '../components/Voice.astro';

// Three situations that bring founders and CEOs to a first conversation. Each has a small line icon.
const situations = [
  { icon: 'loop', title: 'A decision that keeps coming back', lead: 'Everyone understands the problem,', body: 'yet the decision keeps getting postponed, diluted or reversed.' },
  { icon: 'funnel', title: 'A leadership team that has become the bottleneck', lead: 'Capable people, overlapping responsibilities,', body: 'and too many decisions still landing back on your desk.' },
  { icon: 'steps', title: 'A company that has outgrown the way you lead it', lead: 'The business scaled,', body: 'but the way decisions are made and shared did not change with it.' },
];
const icons: Record<string, string> = {
  loop: 'M20 12a8 8 0 1 1-2.34-5.66M20 4v4.5h-4.5',
  funnel: 'M3.5 5h17l-6.5 8v5.5l-4 1.5v-7z',
  steps: 'M3.5 18.5l6-6 4 4 7-7M14.5 9.5h6v6',
};

// Figures stated by Sven (20 years: 2026-10-24; 100+ scope and languages: 2026-10-15/16).
const figures = [
  { n: '20', t: 'years building start-ups' },
  { n: '100+', t: 'founders, MDs and C-suite leaders guided' },
  { n: '4', t: 'working languages' },
  { n: '2', t: 'business schools I research with' },
];

// "How I think": DRAFT composite pattern written as a placeholder for Sven to replace or confirm.
// A second pattern (the COO hire) lives on /advisory.
const pattern = {
  remark: 'My team does not take enough ownership.',
  // Shorter forms for the table layout (v62)
  obviousShort: 'Clearer roles, tighter follow-up, perhaps a different person in one of the seats.',
  learned: "If every important decision eventually comes back to the CEO's desk, escalating is the rational thing to do.",
  ask: 'What does the CEO have to stop doing for real ownership to become possible?',
  obvious: 'The obvious response is to work on accountability: clearer roles, tighter follow-up, perhaps a different person in one of the seats.',
  question: "The question I ask first is what the team has learned. If every important decision eventually comes back to the CEO's desk, escalating is the rational thing to do.",
  shift: 'The useful question then becomes what the CEO has to stop doing for real ownership to become possible.',
};
---
<Layout>
  <!-- 1 · Opening: shared photo hero (see PhotoHero.astro) -->
  <PhotoHero src={heroPhoto} alt="A 1:1 advisory conversation at a table by the window, in an office overlooking the city" pos="object-[72%_center] lg:object-[62%_center]" headingId="hero-heading" tag="Dr. Sven Mulfinger · Independent counsel for founders and CEOs" title="A thinking partner for the decisions you cannot delegate." body="For the moments that weigh most: a turning point for the company, friction inside the executive team or a call that only you can make." />

  <!-- 2 · Situations: why founders and CEOs get in touch -->
  <Chapter id="situations" num="01" note="Why leaders get in touch" heading="When the usual answers stop working." wide>
    <p class="mt-6 reading max-w-[38rem]">Most founders and CEOs who contact me for advisory or a sparring partner arrive with one of these three situations.</p>
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-3 gap-x-6 gap-y-10">
      {situations.map((s, i) => (
        <article class:list={['situation settle pt-5 hair-t hair-strong', `s${i + 1}`]}>
          <p class="display text-[2.4rem] leading-none text-accent">0{i + 1}</p>
          <h3 class="mt-5 text-[1.45rem] sm:text-[1.6rem] leading-[1.12] text-ink">{s.title}.</h3>
          <p class="mt-4 reading"><span class="text-ink">{s.lead}</span> {s.body}</p>
        </article>
      ))}
    </div>
    <p class="mt-8 text-[0.9375rem]"><a href="/contact" class="link">Recognise one of these? Start with a confidential first conversation</a></p>
  </Chapter>

  <!-- 3 · How I think: one worked pattern -->
  <Chapter id="thinking" num="02" note="How I think" heading="Most problems arrive with a label already on them." tone="sand" wide>
    <p slot="margin" class="label mt-3 hidden lg:block max-w-[14rem]">A composite pattern from practice, not an individual client.</p>
    <article class="mt-10">
      <blockquote class="wipe display text-[2rem] sm:text-[2.8rem] lg:text-[3.2rem] leading-[1.02] text-ink max-w-[22ch]">“{pattern.remark}”</blockquote>
      <dl class="mt-10 lg:mt-12">
        <div class="settle py-6 hair-t hair-strong sm:grid sm:grid-cols-9 sm:gap-x-6">
          <dt class="label sm:col-span-3 sm:pt-1">The obvious response</dt>
          <dd class="mt-2 sm:mt-0 sm:col-span-6 reading text-muted! line-through decoration-[0.06em] decoration-line-strong">{pattern.obviousShort}</dd>
        </div>
        <div class="settle s2 py-6 hair-t hair-strong sm:grid sm:grid-cols-9 sm:gap-x-6">
          <dt class="label sm:col-span-3 sm:pt-1">What the team has learned</dt>
          <dd class="mt-2 sm:mt-0 sm:col-span-6 reading">{pattern.learned}</dd>
        </div>
        <div class="settle s3 py-6 hair-t hair-b hair-strong sm:grid sm:grid-cols-9 sm:gap-x-6">
          <dt class="secnum sm:col-span-3 sm:pt-1.5">The question I ask</dt>
          <dd class="mt-2 sm:mt-0 sm:col-span-6 display text-[1.6rem] sm:text-[2rem] leading-[1.12] text-ink">{pattern.ask}</dd>
        </div>
      </dl>
    </article>
  </Chapter>

  <!-- 4 · Background: figures first, then three sentences -->
  <Chapter id="background" num="03" note="Background" heading="I have carried the responsibility too.">
    <dl class="mt-10 grid grid-cols-2 lg:grid-cols-4 hair-t ">
      {figures.map((f, i) => (
        <div class:list={['settle', `s${i + 1}`, 'pt-5 pb-6 pr-4 hair-b  lg:hair-b-0']}>
          <dt class="sr-only">{f.t}</dt>
          <dd class="display text-[2.8rem] sm:text-[3.4rem] leading-none text-ink">{f.n}</dd>
          <dd class="mt-2 label max-w-[11rem]">{f.t}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-10 grid sm:grid-cols-2 gap-x-10 gap-y-8">
      {[
        ['The operator', 'Twenty years building start-ups and serving as CEO in the corporate world, then founding Kuma Partners. I know what it is to carry the whole company.'],
        ['The scientist', 'Molecular genetics and a doctorate in engineering taught me to look for the mechanism underneath the symptom.'],
        ['The advisor', 'More than 100 founders, managing directors and C-suite leaders guided across confidential 1:1 advisory, executive peer councils and board-level interventions.'],
        ['The researcher', 'Recent research on cognitive preferences, within and beyond the neurodivergent spectrum, and how they shape the way people lead.'],
      ].map(([t, b], i) => (
        <div class:list={['settle', `s${i + 1}`, 'pt-5 hair-t']}>
          <h3 class="text-[1.35rem] leading-snug text-ink">{t}</h3>
          <p class="mt-2 reading text-[1.0625rem]!">{b}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-[0.9375rem]"><a href="/about" class="link">More about my background</a></p>
  </Chapter>

  <!-- 5 · Case studies: three real engagements, each folded -->
  <Chapter id="cases" num="04" note="Case studies" heading="Results from the room." tone="dark" wide>
    <p class="mt-6 reading max-w-[38rem]">Three real engagements and what changed for the leaders involved. Confidentiality prevents names, not the substance. Outcomes as reported by the clients.</p>
    <div class="mt-12 grid gap-y-12 lg:grid-cols-3 lg:gap-x-6">
    {cases.map((c, i) => (
      <article class:list={['settle pt-5 hair-t hair-strong flex flex-col', `s${i + 1}`]}>
        <p class="label">{c.n} · {c.context}</p>
        {c.figures ? (
          <div class="mt-6">
            <div class="flex items-baseline gap-8">
              {c.figures.map((f, k) => <p class:list={['display text-[4.2rem] sm:text-[4.8rem] leading-[0.9]', k ? 'text-accent' : 'text-ink']}>{f.n}</p>)}
            </div>
            <p class="mt-3 label">{c.figures.map((f) => f.t).join(' · ')}</p>
          </div>
        ) : (
          <p class="mt-6 display text-[1.75rem] sm:text-[2rem] leading-[1.08] text-ink">{c.outcome ?? c.proof}</p>
        )}
        <h3 class="mt-7 text-[1.25rem] leading-snug text-ink">{c.title}</h3>
        <p class="mt-2 reading text-[1.0625rem]!">{c.summary}</p>
        <details class="case group mt-4">
          <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden inline-flex items-center gap-2 text-[0.9375rem] text-accent">
            <span class="group-open:hidden">Read the case</span><span class="hidden group-open:inline">Close the case</span>
            <span aria-hidden="true" class="transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <ol class="mt-5 space-y-5">
            {[['The situation', c.dilemma], ['What lay beneath', c.issue], ['What changed', c.resolution]].map(([t, b], k) => (
              <li class="pt-4 hair-t">
                <p class="label"><span class="text-accent font-medium">{k + 1}</span> · {t}</p>
                <p class="mt-2 reading text-[1.0625rem]!">{b}</p>
              </li>
            ))}
          </ol>
        </details>
      </article>
    ))}
    </div>
  </Chapter>

  <!-- 5b · Client voices: who says so, straight after what changed -->
  <Chapter id="voices" num="05" note="In their words" heading="What clients say." wide>
    <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
      {testimonials.map((t) => <Voice t={t} />)}
    </div>
    <p class="mt-10 text-[0.9375rem]"><a href="/recommendations" class="link">Read all fourteen recommendations</a></p>
  </Chapter>

  <!-- 6 · Research, short -->
  <Chapter id="research" num="06" tone="sand" note="Research" heading="Why do some leaders excel at seeing possibilities but struggle with the systems needed to scale them?">
    <figure slot="margin" class="mt-5 mb-6 lg:mb-0 lg:mt-6 w-[11.5rem] lg:w-[min(17rem,calc(100%+1rem))]">
      <Image src={bookCover} alt="Kindle cover of The Non-Linear Operating System by Dr. Sven Mulfinger" widths={[184, 272, 368, 544, 816]} sizes="(min-width: 1024px) 272px, 184px" format="webp" quality={85} loading="lazy" decoding="async" class="settle block w-full h-auto shadow-lg" />
    </figure>
    <div class="mt-8 space-y-5 max-w-[38rem]">
      <p class="settle reading">Many founders and executives have a spiky cognitive profile. The same wiring that helps them see around corners also shapes how they delegate, make decisions and handle conflict as their companies grow. Thinking differently brings distinct advantages, but it also comes with its own particular challenges.</p>
      <p class="settle reading"><cite class="text-ink">The Non-Linear Operating System</cite> ({book.publisher.toLowerCase()}, {book.publishedLabel}), written with the Neurodisruptors Research Team in research collaboration with Prof. Dr. Thomas Klueter (IESE Business School) and Prof. Dr. Nicolas Deuschel (IE Business School), draws on field research involving more than 50 serial entrepreneurs and CEOs with non-linear cognitive profiles, including ADHD, giftedness, dyslexia and autism.</p>
      <p class="settle reading">The research explores the similarities and differences in how they think, lead, make decisions and navigate the challenges of scaling a business. Its aim is to understand how their distinctive cognitive strengths shape their leadership, where friction tends to emerge, and how they can build an operating system that works with their minds rather than against them.</p>
    </div>
    <p class="mt-8 flex flex-col sm:flex-row gap-x-8 gap-y-3 text-[0.9375rem]"><a href={book.kindle} target="_blank" rel="noopener noreferrer" class="link">Kindle edition<span class="sr-only"> on Amazon (opens in a new tab)</span></a><a href={book.paperback} target="_blank" rel="noopener noreferrer" class="link">Paperback<span class="sr-only"> on Amazon (opens in a new tab)</span></a><a href={site.links.neurodisruptors} target="_blank" rel="noopener noreferrer" class="link">Explore the research at neurodisruptors.com<span class="sr-only"> (opens in a new tab)</span></a></p>
  </Chapter>

  <!-- 7 · Three ways to work together -->
  <Chapter id="paths" num="07" note="Ways to work together" heading="Three ways to work together.">
    <p class="mt-6 reading max-w-[38rem]">1:1 advisory is the core of my work. The other two exist for when the tension sits elsewhere: between peers, or inside the executive team.</p>
    <Paths />
  </Chapter>

  <!-- 8 · Bridge to /advisory (the FAQ lives there only) -->
  <section aria-label="How 1:1 advisory works">
    <div class="container-x">
      <div class="relative py-10 lg:py-12 lg:grid lg:grid-cols-12 lg:gap-x-10">
        <span aria-hidden="true" class="draw absolute inset-x-0 top-0 h-px hair-t hair-strong"></span>
        <p class="secnum lg:col-span-3 lg:pt-1">Considering an engagement?</p>
        <p class="mt-2 lg:mt-0 lg:col-span-9 reading text-ink!">See how 1:1 advisory works, from the first conversation to the terms, and the twelve questions leaders ask before getting in touch. <a href="/advisory" class="link whitespace-nowrap">How 1:1 advisory works →</a></p>
      </div>
    </div>
  </section>

  <!-- 9 · One invitation -->
  <Invite />
</Layout>
