---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Chapter from '../components/Chapter.astro';
import Paths from '../components/Paths.astro';
import Invite from '../components/Invite.astro';
import bookCover from '../assets/images/book-cover-nonlinear.png';
import roundSession from '../assets/images/the-round-session.jpg';
import offsiteSession from '../assets/images/kuma-offsite-session.jpg';
import { site } from '../data/site';

const situations = [
  {
    n: '01',
    title: 'The decisions that keep coming back',
    lead: 'Repeatedly discussed, never resolved.',
    body: 'Everyone understands the problem. Yet the decision keeps getting postponed, diluted or reversed. By now the useful question is why the organisation cannot resolve it.',
  },
  {
    n: '02',
    title: 'When the leadership team becomes the bottleneck',
    lead: 'Capable people, structural gridlock.',
    body: 'Responsibilities overlap, disagreements stay unresolved and too many decisions still return to the CEO. The work is to understand what is happening between the people as well as within them.',
  },
  {
    n: '03',
    title: 'When the business outgrows the founder',
    lead: 'The company scaled; leadership did not.',
    body: 'How decisions are made and responsibilities are shared has not changed with it. The founder has to work out what to keep, what to let go of and what the next version of their role must look like.',
  },
];

// Field reflections: real engagements, anonymised. Confirmed accurate by Sven on 2026-10-16.
const cases = [
  {
    n: '01',
    title: 'The founder bottleneck',
    context: 'Scale-up CEO · Series B',
    dilemma: "Strategic execution was stalling. Every decision bounced back to the founder's desk, creating operational gridlock and executive burnout.",
    issue: 'The founder was delegating tasks while keeping unspoken veto rights on product nuance. The team protected itself by escalating decisions rather than owning the risk.',
    resolution: 'We codified explicit boundary conditions for autonomous team decisions and rebuilt the executive meeting cadence. The founder reclaimed 15 hours a week and execution pace doubled.',
  },
  {
    n: '02',
    title: 'Artificial alignment',
    context: 'Industrial B2B · €80M ARR',
    dilemma: 'The executive team agreed unanimously in Monday meetings, yet commercial and operations were executing conflicting priorities by Thursday.',
    issue: 'Commercial incentives directly contradicted production capacity. The conflict was structural, while the team kept treating it as a clash of personalities.',
    resolution: 'We surfaced the unaddressed economic trade-offs in a facilitated session and replaced cosmetic harmony with an explicit operating agreement on margin versus volume.',
  },
  {
    n: '03',
    title: 'The lonely decision',
    context: 'Founder and chairman · International',
    dilemma: 'Facing a complex multi-market transition, the founder had nobody inside the organisation who could challenge their logic without an agenda of their own.',
    issue: "The leadership team was managing the founder's temperament instead of stress-testing the valuation models and governance trade-offs.",
    resolution: 'I acted as an independent, unvarnished sparring partner for six months, pressure-testing blind spots and structuring a transition that protected the company culture and shareholder value.',
  },
];


// "How I think": DRAFT composite patterns written as placeholders. Sven to replace or confirm
// with situations from his own practice. They are framed on the page as patterns, not client stories.
const patterns = [
  {
    remark: 'My team does not take enough ownership.',
    obvious: 'The obvious response is to work on accountability: clearer roles, tighter follow-up, perhaps a different person in one of the seats.',
    question: "The question I ask first is what the team has learned. If every important decision eventually comes back to the CEO's desk, escalating is the rational thing to do. What looks like a problem with the team is often a pattern the CEO keeps in place without meaning to.",
    shift: 'The useful question then becomes what the CEO has to stop doing for real ownership to become possible.',
  },
  {
    remark: 'We need to hire a COO.',
    obvious: 'The obvious response is to start a search.',
    question: 'Before that, I want to know which decisions the CEO actually wants to stop making, and which ones they will still quietly take back. A senior hire is often a container for decisions the founder has not yet decided to release.',
    shift: 'If that stays unresolved, the new COO inherits the title without the authority and the company pays for a second bottleneck. Sometimes the answer is still a COO, and it is a far better hire once the decisions the role owns are clear.',
  },
];
---
<Layout>
  <!-- 1 · Opening: typographic, no stock photograph. Never animated. -->
  <section aria-labelledby="hero-heading">
    <div class="container-x pt-12 lg:pt-24 pb-12 lg:pb-16 lg:grid lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-3 lg:pt-4">
        <div class="rise">
          <p class="label text-ink!">Dr. Sven Mulfinger</p>
          <p class="label">Executive advisory for founders and CEOs</p>
          <p class="label mt-3 hidden lg:block">Barcelona · Madrid · online</p>
        </div>
      </div>
      <div class="mt-6 lg:mt-0 lg:col-span-9">
        <h1 id="hero-heading" class="rise rise-2 display text-[2.85rem] sm:text-[4rem] lg:text-[4.6rem] leading-[1.02] text-ink max-w-[15ch]">A thinking partner for the decisions you cannot delegate.</h1>
        <p class="rise rise-3 mt-7 lg:mt-9 reading text-[1.25rem]! sm:text-[1.375rem]! leading-[1.5]! max-w-[36rem]">I work with founders and CEOs when decisions get harder, leadership dynamics become more complicated or the business demands a different kind of leadership.</p>
        <div class="rise rise-4 mt-8 lg:mt-10 flex flex-col sm:flex-row sm:items-center gap-x-6 gap-y-3">
          <a href="/contact" class="inline-flex justify-center items-center gap-2 bg-accent text-paper px-6 py-3.5 text-[0.9375rem] hover:bg-accent-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
          <span class="label">Confidential. Direct. No obligation to continue.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- A real working room: documentary photograph, square corners, newspaper caption -->
  <figure class="container-x pb-4">
    <div class="relative aspect-[4/3] sm:aspect-[3/2] lg:aspect-[2/1] overflow-hidden bg-mist">
      <Image
        src={offsiteSession}
        alt="Dr. Sven Mulfinger and Vincent Azé facilitating an executive leadership team offsite in Berlin"
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1216px) 1136px, 100vw"
        format="webp"
        quality={80}
        loading="eager"
        decoding="async"
        class="drift absolute inset-0 size-full object-cover object-[center_40%]"
      />
    </div>
    <figcaption class="mt-3 label lg:grid lg:grid-cols-12 lg:gap-x-10"><span class="lg:col-start-4 lg:col-span-9">Leadership team offsite in Berlin, run with Vincent Azé for Kuma Partners. The sticky notes are the work.</span></figcaption>
  </figure>

  <!-- 2 · Situations, as prose -->
  <Chapter id="situations" note="Where the work starts" heading="When the usual answers stop working.">
    <div class="mt-8 space-y-6 max-w-[38rem]">
      {situations.map((s) => (
        <p class="settle reading"><em class="text-ink">{s.title}.</em> {s.lead} {s.body}</p>
      ))}
    </div>
  </Chapter>

  <!-- 3 · How I think: two worked patterns -->
  <Chapter id="thinking" note="How I think" heading="Most problems arrive with a label already on them.">
    <p slot="margin" class="label mt-3 hidden lg:block max-w-[14rem]">Composite patterns from practice, not individual clients.</p>
    <p class="mt-6 reading max-w-[38rem]">The useful work usually starts by questioning the label. Two patterns I see often:</p>
    {patterns.map((p) => (
      <article class="settle mt-10 pt-8 border-t border-line max-w-[38rem]">
        <blockquote class="wipe display text-[1.7rem] sm:text-[2.1rem] leading-[1.18] text-ink">“{p.remark}”</blockquote>
        <p class="mt-5 reading">{p.obvious}</p>
        <p class="mt-4 reading">{p.question}</p>
        <p class="mt-4 reading text-ink">{p.shift}</p>
      </article>
    ))}
  </Chapter>

  <!-- 4 · Background as three short narratives -->
  <Chapter id="background" note="Background" heading="I have carried the responsibility too.">
    <dl slot="margin" class="mt-6 hidden lg:block space-y-4 label max-w-[14rem]">
      <div><dt class="text-ink">Trained</dt><dd>Molecular genetics, chemical engineering, doctorate</dd></div>
      <div><dt class="text-ink">Founded</dt><dd>MaterFly, which became Dana; Kuma Partners</dd></div>
      <div><dt class="text-ink">Research</dt><dd>IESE and IE Business School</dd></div>
      <div><dt class="text-ink">Based</dt><dd>Barcelona</dd></div>
    </dl>
    <div class="mt-8 space-y-6 max-w-[38rem]">
      <p class="settle reading"><em class="text-ink">The operator.</em> I spent four years building MaterFly, the venture in women's mental health that became Dana, and then founded Kuma Partners. I know what it is to carry the whole company, including the parts that never reach the pitch deck.</p>
      <p class="settle reading"><em class="text-ink">The scientist.</em> I trained in molecular genetics and chemical engineering and hold a doctorate. Both taught me to look for the mechanism underneath the symptom. In genetics the visible trait is rarely where the cause sits, and in engineering a recurring failure usually points to the process rather than the part.</p>
      <p class="settle reading"><em class="text-ink">The advisor.</em> I have guided more than 100 founders, managing directors and C-suite leaders across confidential 1:1 advisory, executive peer councils and board-level interventions throughout Europe, in English, Spanish, German and French. I grew up between languages and institutions in Brussels, which still shapes how I read a leadership team.</p>
    </div>
    <p class="mt-8 text-[0.9375rem]"><a href="/about" class="link">More about my background</a></p>
  </Chapter>

  <!-- 5 · Field notes: three real engagements, anonymised, set as prose -->
  <Chapter id="cases" note="Field notes" heading="What changed.">
    <p class="mt-6 reading max-w-[38rem]">Confidentiality prevents publishing names. It does not prevent showing how real executive dilemmas get resolved. Three engagements, anonymised.</p>
    {cases.map((c) => (
      <article class="settle mt-10 pt-8 border-t border-line max-w-[38rem]">
        <p class="label">{c.context}</p>
        <h3 class="mt-2 text-[1.6rem] sm:text-[1.85rem] leading-snug text-ink">{c.title}</h3>
        <p class="mt-4 reading"><em class="text-ink">The situation.</em> {c.dilemma}</p>
        <p class="mt-3 reading"><em class="text-ink">Underneath.</em> {c.issue}</p>
        <p class="mt-3 reading"><em class="text-ink">What changed.</em> {c.resolution}</p>
      </article>
    ))}
  </Chapter>

  <!-- 6 · Research: the book cover sits in the margin on desktop -->
  <Chapter id="research" note="Research" heading="Why do some leaders excel at seeing possibilities but struggle with the systems needed to scale them?">
    <figure slot="margin" class="hidden lg:block mt-6 max-w-[11rem]">
      <Image src={bookCover} alt="The Non-Linear Operating System by Dr. Sven Mulfinger" widths={[176, 264, 352, 528]} sizes="176px" format="webp" quality={85} loading="lazy" decoding="async" class="block w-full h-auto shadow-md" />
    </figure>
    <div class="mt-8 space-y-5 max-w-[38rem]">
      <p class="reading">Many founders have spiky cognitive profiles: ADHD, giftedness, dyslexia, autism or a combination that never received a label. The same wiring that lets them see around corners shapes how they delegate, decide and handle conflict once the company grows.</p>
      <p class="reading"><cite class="text-ink">The Non-Linear Operating System</cite> is a forthcoming work developed in collaboration with Prof. Dr. Thomas Kluetter (IESE Business School) and Prof. Dr. Nicolas Deuschel (IE Business School), grounded in research and field analysis across more than 50 serial entrepreneurs and CEOs operating with a non-linear mind.</p>
      <p class="reading">I do not ask every leader to see themselves this way. Understanding how a leader actually operates is simply more useful than asking them to fit a standard model of leadership.</p>
    </div>
    <p class="mt-8 text-[0.9375rem]"><a href={site.links.neurodisruptors} target="_blank" rel="noopener noreferrer" class="link">Explore the research at neurodisruptors.com<span class="sr-only"> (opens in a new tab)</span></a></p>
  </Chapter>

  <!-- 7 · Three ways to work together -->
  <Chapter id="paths" note="Ways to work together" heading="Three ways to work together.">
    <p class="mt-6 reading max-w-[38rem]">1:1 advisory is the core of my work. The other two exist for when the tension sits elsewhere: between peers, or inside the executive team.</p>
    <figure class="mt-8">
      <div class="relative aspect-[3/2] overflow-hidden bg-mist">
        <Image src={roundSession} alt="Dr. Sven Mulfinger facilitating The Round executive peer session in Barcelona." widths={[480, 720, 960, 1024]} sizes="(min-width: 1024px) 680px, 100vw" format="webp" quality={80} loading="lazy" decoding="async" class="drift absolute inset-0 size-full object-cover object-[center_35%]" />
      </div>
      <figcaption class="mt-3 label">The Round, a peer session in Barcelona.</figcaption>
    </figure>
    <Paths />
  </Chapter>

  <!-- 8 · One invitation -->
  <Invite />
</Layout>
