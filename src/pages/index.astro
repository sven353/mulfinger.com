---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Chapter from '../components/Chapter.astro';
import Paths from '../components/Paths.astro';
import Invite from '../components/Invite.astro';
import bookCover from '../assets/images/book-cover-nonlinear.png';
import roundSession from '../assets/images/the-round-session.jpg';
import offsiteSession from '../assets/images/kuma-offsite-session.jpg';
import conversation from '../assets/images/advisory-conversation.jpg';
import { site } from '../data/site';

// Three situations, one sentence each. They stack as cards while you scroll.
const situations = [
  { title: 'The decisions that keep coming back', body: 'Everyone understands the problem, yet the decision keeps getting postponed, diluted or reversed.' },
  { title: 'When the leadership team becomes the bottleneck', body: 'Capable people and overlapping responsibilities, with too many decisions still landing back on the CEO.' },
  { title: 'When the business outgrows the founder', body: 'The company scaled, but the way decisions are made and shared did not change with it.' },
];

// Figures stated by Sven (20 years: 2026-10-24; 100+ scope and languages: 2026-10-15/16).
const figures = [
  { n: '20', t: 'years building start-ups' },
  { n: '100+', t: 'founders, MDs and C-suite leaders guided' },
  { n: '4', t: 'working languages' },
  { n: '2', t: 'business schools I research with' },
];

// Field reflections: real engagements, anonymised. Confirmed accurate by Sven on 2026-10-16.
const cases = [
  {
    n: '01',
    title: 'The founder bottleneck',
    context: 'Scale-up CEO · Series B',
    dilemma: "Strategic execution was stalling. Every decision bounced back to the founder's desk, creating operational gridlock and executive burnout.",
    issue: 'The founder was delegating tasks while keeping unspoken veto rights on product nuance. The team protected itself by escalating decisions rather than owning the risk.',
    resolution: 'We codified explicit boundary conditions for autonomous team decisions and rebuilt the executive meeting cadence. The founder reclaimed 15 hours a week and execution pace doubled.',
  },
  {
    n: '02',
    title: 'Artificial alignment',
    context: 'Industrial B2B · €80M ARR',
    dilemma: 'The executive team agreed unanimously in Monday meetings, yet commercial and operations were executing conflicting priorities by Thursday.',
    issue: 'Commercial incentives directly contradicted production capacity. The conflict was structural, while the team kept treating it as a clash of personalities.',
    resolution: 'We surfaced the unaddressed economic trade-offs in a facilitated session and replaced cosmetic harmony with an explicit operating agreement on margin versus volume.',
  },
  {
    n: '03',
    title: 'The lonely decision',
    context: 'Founder and chairman · International',
    dilemma: 'Facing a complex multi-market transition, the founder had nobody inside the organisation who could challenge their logic without an agenda of their own.',
    issue: "The leadership team was managing the founder's temperament instead of stress-testing the valuation models and governance trade-offs.",
    resolution: 'I acted as an independent, unvarnished sparring partner for six months, pressure-testing blind spots and structuring a transition that protected the company culture and shareholder value.',
  },
];

// "How I think": DRAFT composite pattern written as a placeholder for Sven to replace or confirm.
// A second pattern (the COO hire) lives on /advisory.
const pattern = {
  remark: 'My team does not take enough ownership.',
  obvious: 'The obvious response is to work on accountability: clearer roles, tighter follow-up, perhaps a different person in one of the seats.',
  question: "The question I ask first is what the team has learned. If every important decision eventually comes back to the CEO's desk, escalating is the rational thing to do.",
  shift: 'The useful question then becomes what the CEO has to stop doing for real ownership to become possible.',
};
---
<Layout>
  <!-- 1 · Opening: headline on paper, the photograph bleeding off the right edge (below on mobile) -->
  <section aria-labelledby="hero-heading" class="overflow-x-clip">
    <div class="container-x">
      <div class="lg:grid lg:grid-cols-12 lg:gap-x-10 lg:min-h-[min(44rem,calc(100svh-5rem))]">
        <div class="lg:col-span-7 pt-10 lg:pt-20 pb-10 lg:pb-16 lg:pr-4">
          <p class="rise label"><span class="text-ink">Dr. Sven Mulfinger</span> · Executive advisory for founders and CEOs · Barcelona, Madrid, online</p>
          <h1 id="hero-heading" class="rise rise-2 mt-6 lg:mt-10 display text-[2.75rem] sm:text-[3.75rem] lg:text-[4.35rem] leading-[1.02] text-ink max-w-[13ch]">A thinking partner for the decisions you cannot delegate.</h1>
          <p class="rise rise-3 mt-7 lg:mt-9 reading text-[1.2rem]! sm:text-[1.3rem]! leading-[1.5]! max-w-[32rem]">I work with founders and CEOs when decisions get harder, leadership dynamics become more complicated or the business demands a different kind of leadership.</p>
          <div class="rise rise-4 mt-8 lg:mt-10 flex flex-col sm:flex-row sm:items-center gap-x-6 gap-y-3">
            <a href="/contact" class="inline-flex justify-center items-center gap-2 bg-accent text-paper px-6 py-3.5 text-[0.9375rem] hover:bg-accent-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
            <span class="label">Confidential. Direct. No obligation to continue.</span>
          </div>
        </div>
        <figure class="unveil relative -mx-5 md:-mx-10 lg:mx-0 lg:col-span-5 lg:mr-[calc(min(0px,(76rem-100vw)/2)-2.5rem)] aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto overflow-hidden bg-mist">
          <Image
            src={conversation}
            alt="Dr. Sven Mulfinger in a 1:1 advisory conversation with two executives"
            widths={[480, 800, 1264]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 size-full object-cover object-[47%_35%]"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- 2 · Situations: three cards that stack as you scroll -->
  <Chapter id="situations" note="Where the work starts" heading="When the usual answers stop working.">
    <div class="mt-10 pb-[16svh]">
      {situations.map((s, i) => (
        <article class="stack-card" style={`--i:${i}`}>
          <p class="label">{['One', 'Two', 'Three'][i]} of three</p>
          <h3 class="mt-4 text-[1.75rem] sm:text-[2.25rem] leading-[1.12] text-ink max-w-[20ch]">{s.title}.</h3>
          <p class="mt-4 reading max-w-[30rem]">{s.body}</p>
        </article>
      ))}
    </div>
  </Chapter>

  <!-- 3 · How I think: one worked pattern -->
  <Chapter id="thinking" note="How I think" heading="Most problems arrive with a label already on them.">
    <p slot="margin" class="label mt-3 hidden lg:block max-w-[14rem]">A composite pattern from practice, not an individual client.</p>
    <article class="mt-8 max-w-[38rem]">
      <blockquote class="wipe display text-[1.8rem] sm:text-[2.3rem] leading-[1.15] text-ink">“{pattern.remark}”</blockquote>
      <p class="settle mt-6 reading">{pattern.obvious}</p>
      <p class="settle mt-4 reading">{pattern.question}</p>
      <p class="settle mt-4 reading text-ink">{pattern.shift}</p>
    </article>
  </Chapter>

  <!-- A breather: the working room, full width, with the line that explains it -->
  <section aria-labelledby="room-quote">
    <figure>
      <div class="relative w-full h-[58svh] min-h-[20rem] max-h-[42rem] overflow-hidden bg-mist">
        <Image
          src={offsiteSession}
          alt="Dr. Sven Mulfinger and Vincent Azé facilitating an executive leadership team offsite in Berlin"
          widths={[640, 960, 1200]}
          sizes="100vw"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
          class="drift absolute inset-0 size-full object-cover object-[center_40%]"
        />
      </div>
      <div class="container-x">
        <div class="pt-10 pb-6 lg:pt-14 lg:grid lg:grid-cols-12 lg:gap-x-10">
          <blockquote id="room-quote" class="wipe lg:col-start-4 lg:col-span-8 display text-[1.85rem] sm:text-[2.6rem] lg:text-[3rem] leading-[1.1] text-ink max-w-[24ch]">“The best moment comes when we step back and the team holds the difficult conversation itself.”</blockquote>
          <figcaption class="mt-5 label lg:col-start-4 lg:col-span-8 max-w-[38rem]">Leadership team offsite in Berlin, with Vincent Azé. Our work is to orchestrate everything that leads up to that moment.</figcaption>
        </div>
      </div>
    </figure>
  </section>

  <!-- 4 · Background: figures first, then three sentences -->
  <Chapter id="background" note="Background" heading="I have carried the responsibility too.">
    <dl class="mt-10 grid grid-cols-2 lg:grid-cols-4 border-t border-line">
      {figures.map((f, i) => (
        <div class:list={['settle', `s${i + 1}`, 'pt-5 pb-6 pr-4 border-b border-line lg:border-b-0']}>
          <dt class="sr-only">{f.t}</dt>
          <dd class="display text-[2.8rem] sm:text-[3.4rem] leading-none text-ink">{f.n}</dd>
          <dd class="mt-2 label max-w-[11rem]">{f.t}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-10 space-y-5 max-w-[38rem]">
      <p class="settle reading"><em class="text-ink">The operator.</em> Twenty years building start-ups and serving as CEO in the corporate world, then founding Kuma Partners. I know what it is to carry the whole company, including the parts that never reach the pitch deck.</p>
      <p class="settle reading"><em class="text-ink">The scientist.</em> Molecular genetics, chemical engineering and a doctorate taught me to look for the mechanism underneath the symptom.</p>
      <p class="settle reading"><em class="text-ink">The advisor.</em> More than 100 founders, managing directors and C-suite leaders guided across confidential 1:1 advisory, executive peer councils and board-level interventions throughout Europe.</p>
    </div>
    <p class="mt-8 text-[0.9375rem]"><a href="/about" class="link">More about my background</a></p>
  </Chapter>

  <!-- 5 · Field notes: one case open, two a click away -->
  <Chapter id="cases" note="Field notes" heading="What changed.">
    <p class="mt-6 reading max-w-[38rem]">Three real engagements, anonymised. Confidentiality prevents names, not the substance.</p>
    {cases.map((c, i) => i === 0 ? (
      <article class="settle mt-10 pt-8 border-t border-line max-w-[38rem]">
        <p class="label">{c.context}</p>
        <h3 class="mt-2 text-[1.6rem] sm:text-[1.85rem] leading-snug text-ink">{c.title}</h3>
        <p class="mt-4 reading"><em class="text-ink">The situation.</em> {c.dilemma}</p>
        <p class="mt-3 reading"><em class="text-ink">Underneath.</em> {c.issue}</p>
        <p class="mt-3 reading"><em class="text-ink">What changed.</em> {c.resolution}</p>
      </article>
    ) : (
      <article class="settle mt-8 pt-7 border-t border-line max-w-[38rem]">
        <details class="case group">
          <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden">
            <span class="label block">{c.context}</span>
            <span class="mt-2 block font-serif text-[1.6rem] sm:text-[1.85rem] leading-snug text-ink">{c.title}</span>
            <span class="mt-3 inline-flex items-center gap-2 text-[0.9375rem] text-accent"><span class="group-open:hidden">Read the case</span><span class="hidden group-open:inline">Close the case</span><span aria-hidden="true" class="transition-transform duration-200 group-open:rotate-180">↓</span></span>
          </summary>
          <p class="mt-4 reading"><em class="text-ink">The situation.</em> {c.dilemma}</p>
          <p class="mt-3 reading"><em class="text-ink">Underneath.</em> {c.issue}</p>
          <p class="mt-3 reading"><em class="text-ink">What changed.</em> {c.resolution}</p>
        </details>
      </article>
    ))}
  </Chapter>

  <!-- 6 · Research, short -->
  <Chapter id="research" note="Research" heading="Why do some leaders excel at seeing possibilities but struggle with the systems needed to scale them?">
    <figure slot="margin" class="hidden lg:block mt-6 max-w-[11rem]">
      <Image src={bookCover} alt="The Non-Linear Operating System by Dr. Sven Mulfinger" widths={[176, 264, 352, 528]} sizes="176px" format="webp" quality={85} loading="lazy" decoding="async" class="block w-full h-auto shadow-md" />
    </figure>
    <div class="mt-8 space-y-5 max-w-[38rem]">
      <p class="settle reading">Many founders have spiky cognitive profiles. The same wiring that lets them see around corners shapes how they delegate, decide and handle conflict as the company grows.</p>
      <p class="settle reading"><cite class="text-ink">The Non-Linear Operating System</cite>, developed with Prof. Dr. Thomas Kluetter (IESE Business School) and Prof. Dr. Nicolas Deuschel (IE Business School), draws on field analysis of more than 50 serial entrepreneurs and CEOs.</p>
    </div>
    <p class="mt-8 text-[0.9375rem]"><a href={site.links.neurodisruptors} target="_blank" rel="noopener noreferrer" class="link">Explore the research at neurodisruptors.com<span class="sr-only"> (opens in a new tab)</span></a></p>
  </Chapter>

  <!-- 7 · Three ways to work together -->
  <Chapter id="paths" note="Ways to work together" heading="Three ways to work together.">
    <p class="mt-6 reading max-w-[38rem]">1:1 advisory is the core of my work. The other two exist for when the tension sits elsewhere: between peers, or inside the executive team.</p>
    <figure class="mt-8">
      <div class="relative aspect-[3/2] overflow-hidden bg-mist">
        <Image src={roundSession} alt="Dr. Sven Mulfinger facilitating The Round executive peer session in Barcelona." widths={[480, 720, 960, 1024]} sizes="(min-width: 1024px) 680px, 100vw" format="webp" quality={80} loading="lazy" decoding="async" class="drift absolute inset-0 size-full object-cover object-[center_35%]" />
      </div>
      <figcaption class="mt-3 label">The Round, a peer session in Barcelona.</figcaption>
    </figure>
    <Paths />
  </Chapter>

  <!-- 8 · One invitation -->
  <Invite />
</Layout>
