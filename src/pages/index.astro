---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroPortrait from '../assets/images/sven-hero.jpg';
import bookCover from '../assets/images/book-cover-nonlinear.png';
import roundSession from '../assets/images/the-round-session.jpg';
import { site } from '../data/site';

// The site's single photograph. Astro generates responsive WebP sizes at build time.
// object-position keeps Sven at the centre of the 4:5 crop of the landscape original.

const situations = [
  {
    n: '01',
    title: 'The decisions that keep coming back',
    body: 'You have discussed the issue repeatedly. Everyone understands the problem. Yet the decision keeps getting postponed, diluted or reversed. By now the useful question is why the organisation cannot resolve it.',
  },
  {
    n: '02',
    title: 'When the leadership team becomes the bottleneck',
    body: 'The people around the table are capable. But responsibilities overlap, disagreements stay unresolved and too many decisions still return to the CEO. The work is to understand what is happening between the people as well as within them.',
  },
  {
    n: '03',
    title: 'When the business outgrows the founder',
    body: 'The company has scaled. The way decisions are made, responsibilities are shared and leadership operates may not have changed with it. The founder has to work out what to keep, what to let go of and what the next version of their role must look like.',
  },
];

const pillars = [
  {
    title: 'Entrepreneurial experience',
    body: 'Firsthand responsibility for founding and building companies: four years on MaterFly, the venture in women\'s mental health that became Dana, then founding Kuma Partners. I know what it is to carry the whole company, including the parts that never reach the pitch deck.',
  },
  {
    title: 'Executive and international practice',
    body: 'Over 100 founders, managing directors and C-suite leaders guided across confidential 1:1 advisory, executive peer councils and board-level interventions throughout Europe, in English, Spanish, German and French. I grew up between languages and institutions in Brussels, which still shapes how I read a leadership team.',
  },
  {
    title: 'Research and governance',
    body: 'Research collaboration with IESE Business School since a 2015 case study with Prof. Iñigo Gallo, and with IE Business School. With Prof. Thomas Kluetter and Prof. Nicolas Deuschel I study how founders with non-linear minds lead and govern.',
  },
];

const steps = [
  { n: '01', t: 'Bring the real issue', b: 'We start with the decision, conflict or transition that is actually occupying your attention.' },
  { n: '02', t: 'Understand what is underneath', b: 'We examine the assumptions, power dynamics, incentives and structural friction shaping the situation.' },
  { n: '03', t: 'Challenge your thinking', b: 'We test uncomfortable options, pressure-test blind spots and name what is being avoided.' },
  { n: '04', t: 'Decide what happens next', b: 'You leave with clarity of judgement and a concrete action to take forward.' },
];
// Field reflections: real engagements, anonymised. Confirmed accurate by Sven on 2026-10-16.
const cases = [
  {
    n: '01',
    title: 'The founder bottleneck',
    context: 'Scale-up CEO · Series B',
    dilemma: "Strategic execution was stalling. Every decision bounced back to the founder's desk, creating operational gridlock and executive burnout.",
    issue: 'The founder was delegating tasks while keeping unspoken veto rights on product nuance. The team protected itself by escalating decisions rather than owning the risk.',
    resolution: 'We codified explicit boundary conditions for autonomous team decisions and rebuilt the executive meeting cadence. The founder reclaimed 15 hours a week and execution pace doubled.',
  },
  {
    n: '02',
    title: 'Artificial alignment',
    context: 'Industrial B2B · €80M ARR',
    dilemma: 'The executive team agreed unanimously in Monday meetings, yet commercial and operations were executing conflicting priorities by Thursday.',
    issue: 'Commercial incentives directly contradicted production capacity. The conflict was structural, while the team kept treating it as a clash of personalities.',
    resolution: 'We surfaced the unaddressed economic trade-offs in a facilitated session and replaced cosmetic harmony with an explicit operating agreement on margin versus volume.',
  },
  {
    n: '03',
    title: 'The lonely decision',
    context: 'Founder and chairman · International',
    dilemma: 'Facing a complex multi-market transition, the founder had nobody inside the organisation who could challenge their logic without an agenda of their own.',
    issue: "The leadership team was managing the founder's temperament instead of stress-testing the valuation models and governance trade-offs.",
    resolution: 'I acted as an independent, unvarnished sparring partner for six months, pressure-testing blind spots and structuring a transition that protected the company culture and shareholder value.',
  },
];
---
<Layout>
  <!-- 1 · Hero
       md and up: text column 5/12 (about 42%), photo 7/12 (about 58%), photo shown in its natural landscape ratio.
       Mobile: DOM order gives eyebrow, headline, photo, supporting text, then the call to action. -->
  <!-- Hero backdrop: a barely perceptible diagonal from warm cream to gallery grey -->
  <section class="bg-linear-to-tr from-[#FAF9F6] via-[#F5F4EE] to-[#ECEAE6]">
  <div class="container-x pt-14 md:pt-20 lg:pt-28 pb-20 md:pb-24 lg:pb-28">
    <div class="grid md:grid-cols-12 md:gap-x-10 lg:gap-x-14 md:items-center">
      <div class="md:col-span-5 md:row-start-1 md:self-end max-w-[27.5rem]">
        <p class="text-[11px] font-medium tracking-[0.18em] uppercase text-steel">Executive advisory · Founders and CEOs</p>
        <h1 class="mt-4 md:mt-6 font-serif text-4xl md:text-[2.6rem] lg:text-5xl leading-[1.15] tracking-[-0.01em] text-ink text-balance">A thinking partner for the decisions you cannot delegate.</h1>
      </div>

      <figure class="mt-10 md:mt-0 md:col-span-7 md:col-start-6 md:row-start-1 md:row-span-2">
        <div class="relative aspect-[3/2] overflow-hidden rounded-2xl lg:rounded-[1.75rem] border border-ink/5 bg-mist shadow-md">
          <Image
            src={heroPortrait}
            alt="Dr. Sven Mulfinger advising founders and CEOs"
            widths={[480, 720, 960, 1256]}
            sizes="(min-width: 768px) 58vw, 100vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 size-full object-cover object-center"
          />
        </div>
        <figcaption class="mt-2 text-right text-[11px] tracking-wide text-steel/80">Dr. Sven Mulfinger</figcaption>
      </figure>

      <div class="mt-8 md:mt-8 md:col-span-5 md:row-start-2 md:self-start max-w-[27.5rem] space-y-8">
        <p class="text-base lg:text-lg text-steel leading-relaxed max-w-lg">I work with founders and CEOs when decisions get harder, leadership dynamics become more complicated or the business demands a different kind of leadership.</p>
        <div>
          <a href="/contact" class="inline-flex items-center gap-2 whitespace-nowrap rounded-sm bg-ink text-paper px-6 md:px-5 lg:px-6 py-3.5 text-sm hover:bg-ink-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
          <span class="mt-3 block text-xs text-steel">Confidential. Direct. No obligation to continue.</span>
        </div>
      </div>
    </div>
  </div>
  </section>

  <!-- 2 · Situations: header, one full-width hairline, then a balanced three-column grid -->
  <section class="border-t border-line bg-paper" aria-labelledby="situations-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
      <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Where the work starts</p>
      <h2 id="situations-heading" class="mt-2 mb-8 font-serif text-3xl md:text-4xl text-ink max-w-xl text-balance">The problems that bring CEOs to the table.</h2>
      </div>
      <div class="border-t border-line mb-10" role="presentation"></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        {situations.map((s, i) => (
          <article class:list={['reveal', `delay-${(i + 1) * 100}`]}>
            <span class="mb-3 block font-mono text-xs text-steel/70 tabular-nums">{s.n}</span>
            <h3 class="mb-3 font-serif text-xl md:text-2xl text-ink leading-snug">{s.title}</h3>
            <p class="text-sm leading-relaxed text-steel">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · Background: header block, then three pillars under one hairline -->
  <section class="bg-mist border-y border-line" aria-labelledby="background-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Background</p>
        <h2 id="background-heading" class="mt-2 mb-4 font-serif text-3xl md:text-4xl text-ink">I have sat on both sides of the table.</h2>
        <p class="mb-12 max-w-2xl text-lg text-ink/80 leading-relaxed">I trained in molecular genetics and chemical engineering and hold a doctorate. I have founded and built companies and carried the decisions that come with them. That is the experience I bring when a founder or CEO has a hard call to make.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 pt-8 border-t border-line">
        {pillars.map((p, i) => (
          <div class:list={['reveal', `delay-${(i + 1) * 100}`]}>
            <h3 class="mb-3 font-serif text-xl md:text-2xl text-ink leading-snug">{p.title}</h3>
            <p class="text-sm leading-relaxed text-steel">{p.body}</p>
          </div>
        ))}
      </div>
      <a href="/about" class="reveal mt-12 inline-flex items-center gap-2 text-sm border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">More about my background <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 4 · Process: four steps in sequence -->
  <section aria-labelledby="process-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">The work</p>
        <h2 id="process-heading" class="mt-2 mb-10 md:mb-12 font-serif text-3xl md:text-4xl text-ink">What happens when we work together.</h2>
      </div>
      <ol class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {steps.map((s, i) => (
          <li class:list={['reveal border-t border-line-strong pt-4', i > 0 && `delay-${Math.min(i, 3) * 100}`]}>
            <span class="block font-mono text-xs text-steel/70 tabular-nums">{s.n}</span>
            <h3 class="mt-3 font-serif text-xl text-ink leading-snug">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4b · Field reflections: three anonymised cases from real engagements -->
  <section class="bg-paper border-y border-line" aria-labelledby="cases-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Field reflections · Judgement in practice</p>
        <h2 id="cases-heading" class="mt-2 mb-4 font-serif text-3xl md:text-4xl text-ink">How this looks in the room.</h2>
        <p class="max-w-2xl text-lg text-ink/80 leading-relaxed">Confidentiality prevents publishing names. It does not prevent showing how real executive dilemmas get resolved.</p>
      </div>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        {cases.map((c, i) => (
          <article class:list={['reveal border-t border-line-strong pt-5', `delay-${(i + 1) * 100}`]}>
            <span class="block font-mono text-xs text-steel/70 tabular-nums">Case {c.n}</span>
            <h3 class="mt-3 font-serif text-xl md:text-2xl text-ink leading-snug">{c.title}</h3>
            <p class="mt-2 text-[11px] tracking-[0.14em] uppercase font-medium text-steel">{c.context}</p>
            <dl class="mt-6 space-y-5 text-sm leading-relaxed">
              <div>
                <dt class="font-serif text-base text-ink">The dilemma</dt>
                <dd class="mt-1 text-steel">{c.dilemma}</dd>
              </div>
              <div>
                <dt class="font-serif text-base text-ink">What lay beneath</dt>
                <dd class="mt-1 text-steel">{c.issue}</dd>
              </div>
              <div>
                <dt class="font-serif text-base text-ink">Resolution</dt>
                <dd class="mt-1 text-steel">{c.resolution}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 · Engagement paths: three cards, 1:1 as the primary offer -->
  <section class="border-t border-line" aria-labelledby="paths-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Ways to work together</p>
        <h2 id="paths-heading" class="mt-2 mb-10 md:mb-12 font-serif text-3xl md:text-4xl text-ink">Three paths, one starting point.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <article class="reveal delay-100 flex flex-col justify-between rounded-xl border border-line-strong bg-mist p-8">
          <div>
            <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Primary · Individual</p>
            <h3 class="mt-5 font-serif text-2xl md:text-[1.75rem] text-ink leading-snug">1:1 Executive Advisory</h3>
            <p class="mt-4 text-sm leading-relaxed text-steel">Confidential strategic counsel for individual founders and CEOs. Two sessions a month for 6 or 12 months, in Barcelona, Madrid or online, with direct access in between when a decision cannot wait.</p>
          </div>
          <a href="/advisory" class="mt-8 inline-flex items-center gap-2 self-start rounded-sm bg-ink text-paper px-5 py-3 text-sm hover:bg-ink-hover transition-colors">How 1:1 advisory works <span aria-hidden="true">→</span></a>
        </article>
        <article class="reveal delay-200 flex flex-col justify-between rounded-xl border border-line bg-white p-8">
          <div>
            <!-- 16:9 crop centred at 35%: keeps Sven, the banner and the screen; drops the bottles and name tents in the foreground -->
            <figure class="mb-6">
              <div class="relative aspect-video overflow-hidden rounded-2xl border border-ink/5 shadow-sm bg-mist">
                <Image
                  src={roundSession}
                  alt="Dr. Sven Mulfinger facilitating The Round executive peer session in Barcelona."
                  widths={[360, 540, 720, 1024]}
                  sizes="(min-width: 768px) 30vw, 100vw"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 size-full object-cover object-[center_35%]"
                />
              </div>
              <figcaption class="mt-2 text-[11px] tracking-wide text-steel/80">The Round · Executive peer council in session, Barcelona.</figcaption>
            </figure>
            <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Peer group · Barcelona</p>
            <h3 class="mt-5 font-serif text-2xl md:text-[1.75rem] text-ink leading-snug">The Round</h3>
            <p class="mt-4 text-sm leading-relaxed text-steel">A private peer collective in Barcelona for founders and CEOs of high-growth companies. Monthly sessions on live issues with people who carry the same weight. By application or nomination.</p>
          </div>
          <a href="/advisory#the-round" class="mt-8 inline-flex items-center gap-2 self-start text-sm border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">About The Round <span aria-hidden="true">→</span></a>
        </article>
        <article class="reveal delay-300 flex flex-col justify-between rounded-xl border border-line bg-white p-8">
          <div>
            <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Leadership teams</p>
            <h3 class="mt-5 font-serif text-2xl md:text-[1.75rem] text-ink leading-snug">Kuma Partners</h3>
            <p class="mt-4 text-sm leading-relaxed text-steel">My institutional practice for leadership team offsites, enterprise operating models and the 14-Day Leadership Friction Diagnostic, run with partners who have led companies themselves.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm">
            <a href={site.links.kuma} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">kuma.partners <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
            <a href={site.links.offsite} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">Offsites <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 6 · Research -->
  <section id="research" class="bg-mist border-y border-line scroll-mt-16" aria-labelledby="research-heading">
    <div class="container-x py-24 md:py-32 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-4 reveal">
        <figure class="mx-auto lg:mx-0 max-w-[19rem]">
          <Image
            src={bookCover}
            alt="The Non-Linear Operating System by Dr. Sven Mulfinger"
            widths={[304, 456, 608, 912]}
            sizes="(min-width: 1024px) 304px, 70vw"
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="block w-full h-auto rounded-sm shadow-2xl"
          />
        </figure>
      </div>
      <div class="lg:col-span-7 lg:col-start-6 reveal delay-100">
        <p class="label text-steel">Research &amp; intellectual property</p>
        <h2 id="research-heading" class="mt-6 display text-3xl md:text-5xl text-balance">Why do some leaders excel at seeing possibilities but struggle with the systems needed to scale them?</h2>
        <div class="mt-8 space-y-5 text-lg text-steel leading-relaxed max-w-2xl">
          <p>Many founders have spiky cognitive profiles: ADHD, giftedness, dyslexia, autism or a combination that never received a label. The same wiring that lets them see around corners shapes how they delegate, decide and handle conflict once the company grows.</p>
          <p><em>The Non-Linear Operating System</em> is a forthcoming work developed in collaboration with Prof. Dr. Thomas Kluetter (IESE Business School) and Prof. Dr. Nicolas Deuschel (IE Business School), grounded in research and field analysis across more than 50 serial entrepreneurs and CEOs operating with a non-linear mind.</p>
        </div>
        <a href={site.links.neurodisruptors} target="_blank" rel="noopener noreferrer" class="mt-10 inline-flex items-center gap-2 text-sm border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">Explore the research at neurodisruptors.com <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <!-- 8 · Final invitation (section 7 of the brief is the removal of FAQ and slogans) -->
  <section aria-labelledby="invite-heading">
    <div class="container-x py-28 md:py-40 text-center reveal">
      <h2 id="invite-heading" class="display text-4xl md:text-7xl max-w-[16ch] mx-auto text-balance">Bring the decision you have been circling.</h2>
      <a href="/contact" class="mt-12 inline-flex items-center gap-3 bg-ink text-paper px-8 py-4 text-sm hover:bg-ink-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
      <p class="mt-4 text-sm text-steel">Confidential. Direct. No obligation to continue.</p>
    </div>
  </section>
</Layout>
