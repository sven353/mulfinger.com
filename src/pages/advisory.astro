---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/faq';
import { site } from '../data/site';
import Chapter from '../components/Chapter.astro';
import Invite from '../components/Invite.astro';
import PhotoHero from '../components/PhotoHero.astro';
import heroPhoto from '../assets/images/hero-office.jpg';

const forWhom = [
  'Founders whose company has outgrown the way they lead it',
  'Scale-up CEOs facing decisions only they can take',
  'Enterprise executives stepping into a bigger or different role',
  'Leaders whose team looks aligned in meetings but splinters in execution',
];

// Mirrors FAQ Q2 so the page and the schema say the same thing.
const workOn = [
  'A co-founder relationship that has quietly broken down',
  'An executive who no longer fits the stage of the company',
  'Decisions that keep landing back on your desk',
  'A strategy the team agrees with in the room and ignores outside it',
  'A board conversation you need to prepare',
  'Your own role changing as the company grows',
];

// Deliberately out of scope (from the site's existing copy and FAQ Q1)
const outOfScope = [
  'Entry-level business coaching or generic career advice',
  'Therapy',
  'A consulting report or a strategy deck',
  'Work with the whole leadership team, which runs through Kuma Partners',
];

const terms = [
  ['Term', '6-month or 12-month retainer'],
  ['Sessions', 'Two working sessions of 60 to 90 minutes a month, fortnightly'],
  ['Where', 'Online, or in person in Barcelona or Madrid'],
  ['Between sessions', 'Direct priority access by voice or message when a decision cannot wait'],
  ['Also included', 'Periodic review of your key strategic documents'],
  ['Fees', 'Shared after the first conversation, once scope is clear'],
];

const steps = [
  { when: 'Before anything is agreed', t: 'First conversation', b: 'Confidential and exploratory. We look at the situation and decide together whether working together makes sense.' },
  { when: 'Before the agreement is signed', t: 'Strategic Friction Diagnostic', b: 'If it does, we map what is really driving the situation and agree the outcomes we are aiming for.' },
  { when: 'Six or twelve months', t: 'Working sessions', b: 'Two sessions a month on the live decisions, with direct access in between when something cannot wait.' },
  { when: 'At the end of the term', t: 'Review', b: 'We review against the outcomes we set and decide together whether to continue, change course or stop.' },
];

const expectations = [
  { t: 'Mutual candour', b: 'I will tell you what I see, including the parts that are uncomfortable. I ask the same of you: bring the real issue rather than the presentable one.' },
  { t: 'Rigorous preparation', b: 'I prepare every session. You come with the decision in front of you and the information that matters.' },
  { t: 'Confidentiality', b: 'Nothing you share reaches your board, investors or team unless you decide it should.' },
];
---
<Layout faq={faq} title="Advisory | Sven Mulfinger" description="How 1:1 executive advisory with Sven Mulfinger works: who it is for, what we work on, retainer and session cadence, what to expect, The Round and Kuma Partners, and a short FAQ.">
  <!-- Opening: same photo hero as the homepage -->
  <PhotoHero src={heroPhoto} alt="Dr. Sven Mulfinger in a 1:1 advisory conversation with two executives in a Barcelona office" pos="object-[56%_center] lg:object-left" headingId="advisory-heading" tag="Dr. Sven Mulfinger · 1:1 Executive Advisory" title="Confidential counsel for the decisions that carry consequences." body="We work together over six or twelve months. Twice a month we sit down for 60 to 90 minutes on the decisions in front of you, in Barcelona, Madrid or online, with direct access in between." />

  <nav aria-label="On this page" class="container-x mt-2 lg:mt-6 pb-2">
    <div class="lg:grid lg:grid-cols-12 lg:gap-x-10">
      <p class="label lg:col-span-3">On this page</p>
      <div class="mt-2 lg:mt-0 lg:col-span-9 flex flex-wrap gap-x-6 gap-y-2 text-[0.875rem]">
        <a href="#who" class="text-muted hover:text-ink">Who this is for</a>
        <a href="#how" class="text-muted hover:text-ink">How it works</a>
        <a href="#expect" class="text-muted hover:text-ink">What to expect</a>
        <a href="#the-round" class="text-muted hover:text-ink">Other ways to work together</a>
        <a href="#faq" class="text-muted hover:text-ink">FAQ</a>
      </div>
    </div>
  </nav>


  <Chapter id="who" note="Fit" heading="Who this is for, and where I draw the line." wide>
    <p class="mt-6 reading max-w-[38rem]">Typically you already execute well. What has changed is the scale, the stakes or the people around you.</p>
    <ul class="mt-8 max-w-[38rem] hair-t">
      {forWhom.map((f) => <li class="py-3 hair-b reading text-[1.0625rem]!">{f}</li>)}
    </ul>
    <div class="mt-12 grid sm:grid-cols-2 gap-10 sm:gap-12">
      <div>
        <h3 class="text-[1.45rem] text-ink">In scope</h3>
        <ul class="mt-4 hair-t">
          {workOn.map((f) => <li class="py-3 hair-b reading text-[1.0625rem]!">{f}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-[1.45rem] text-ink">Deliberately out of scope</h3>
        <ul class="mt-4 hair-t">
          {outOfScope.map((f) => <li class="py-3 hair-b reading text-[1.0625rem]! text-muted!">{f}</li>)}
        </ul>
      </div>
    </div>
  </Chapter>

  <Chapter id="how" note="Engagement" heading="How an engagement works.">
    <dl class="mt-8 hair-t ">
      {terms.map(([k, v]) => (
        <div class="py-4 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-8 hair-b ">
          <dt class="label sm:pt-1">{k}</dt>
          <dd class="mt-1 sm:mt-0 reading text-ink!">{v}</dd>
        </div>
      ))}
    </dl>
    <h3 class="mt-14 text-[1.45rem] text-ink">The sequence</h3>
    <ol class="mt-4 hair-t ">
      {steps.map((s, i) => (
        <li class="py-5 grid grid-cols-[2rem_1fr] gap-x-3 hair-b ">
          <span class="font-serif text-[1.35rem] leading-snug text-muted">{i + 1}.</span>
          <div>
            <p class="label">{s.when}</p>
            <p class="mt-1 font-serif text-[1.35rem] leading-snug text-ink">{s.t}</p>
            <p class="mt-1.5 reading">{s.b}</p>
          </div>
        </li>
      ))}
    </ol>
  </Chapter>

  <Chapter id="expect" note="Expectations" heading="What to expect.">
    <div class="mt-8 space-y-6 max-w-[38rem]">
      {expectations.map((e) => <p class="settle reading"><em class="text-ink">{e.t}.</em> {e.b}</p>)}
    </div>
  </Chapter>

  <!-- A pattern I see often (moved from the homepage). DRAFT: Sven to confirm or replace. -->
  <Chapter id="thinking" note="How I think" heading="A request I hear often, and the question I ask first.">
    <p slot="margin" class="label mt-3 hidden lg:block max-w-[14rem]">A composite pattern from practice, not an individual client.</p>
    <article class="mt-8 max-w-[40rem] bg-mist hair-all hair-strong px-6 py-8 sm:px-10 sm:py-10">
      <p class="label">Field memo · The COO request</p>
      <blockquote class="mt-4 wipe display text-[1.8rem] sm:text-[2.3rem] leading-[1.15] text-ink">“We need to hire a COO.”</blockquote>
      <p class="settle mt-6 reading">The obvious response is to start a search.</p>
      <p class="settle mt-4 reading">Before that, I want to know which decisions the CEO actually wants to stop making, and which ones they will still quietly take back. A senior hire is often a container for decisions the founder has not yet decided to release.</p>
      <p class="settle mt-4 reading text-ink">If that stays unresolved, the new COO inherits the title without the authority. Sometimes the answer is still a COO, and it is a far better hire once the decisions the role owns are clear.</p>
    </article>
  </Chapter>

  <!-- Quiet routing: the full three-way overview lives on the homepage -->
  <section id="the-round" aria-labelledby="paths-heading" class="scroll-mt-20">
    <div class="container-x">
      <div class="relative py-10 lg:py-12 lg:grid lg:grid-cols-12 lg:gap-x-10">
        <span aria-hidden="true" class="draw absolute inset-x-0 top-0 h-px hair-t hair-strong"></span>
        <p class="label lg:col-span-3 lg:pt-1">Other ways to work together</p>
        <div class="mt-2 lg:mt-0 lg:col-span-8 xl:col-span-7 space-y-2">
          <h2 id="paths-heading" class="sr-only">Other ways to work together</h2>
          <p class="reading">Looking for a leadership team offsite or work with the whole executive team? <a href={site.links.kuma} target="_blank" rel="noopener noreferrer" class="link">Kuma Partners<span class="sr-only"> (opens in a new tab)</span></a> and <a href={site.links.offsite} target="_blank" rel="noopener noreferrer" class="link">Offsites<span class="sr-only"> (opens in a new tab)</span></a>.</p>
          <p class="reading">Looking for a confidential peer group of founders and CEOs in Barcelona? <a href={site.links.round} target="_blank" rel="noopener noreferrer" class="link">The Round<span class="sr-only"> (opens in a new tab)</span></a>.</p>
        </div>
      </div>
    </div>
  </section>

  <Faq heading="Before you get in touch." intro="The questions leaders ask before a first conversation. Open any one for the short answer." />

  <Invite heading="Start with a first conversation." body="Confidential and exploratory. If there is a fit, we map the situation in a short Strategic Friction Diagnostic before anything is signed. If I am not the right person for what you describe, I will say so." />
</Layout>
