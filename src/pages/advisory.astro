---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/faq';
import { site } from '../data/site';

const forWhom = [
  'Founders whose company has outgrown the way they lead it',
  'Scale-up CEOs facing decisions only they can take',
  'Enterprise executives stepping into a bigger or different role',
  'Leaders whose team looks aligned in meetings but splinters in execution',
];

const terms = [
  ['Term', '6-month or 12-month retainer'],
  ['Sessions', 'Two working sessions of 60 to 90 minutes a month, fortnightly'],
  ['Where', 'Online, or in person in Barcelona or Madrid'],
  ['Between sessions', 'Direct priority access by voice or message when a decision cannot wait'],
  ['Also included', 'Periodic review of your key strategic documents'],
  ['Fees', 'Shared after the first conversation, once scope is clear'],
];

const steps = [
  { n: '01', t: 'First conversation', b: 'Confidential and exploratory. We look at the situation and decide together whether working together makes sense.' },
  { n: '02', t: 'Strategic Friction Diagnostic', b: 'If it does, we map what is really driving the situation and agree the outcomes we are aiming for.' },
  { n: '03', t: 'Working sessions', b: 'Fortnightly sessions on the live decisions, with direct access in between.' },
  { n: '04', t: 'Review', b: 'We review against the outcomes we set and decide together whether to continue, change course or stop.' },
];

const expectations = [
  { t: 'Mutual candour', b: 'I will tell you what I see, including the parts that are uncomfortable. I ask the same of you: bring the real issue rather than the presentable one.' },
  { t: 'Rigorous preparation', b: 'I prepare every session. You come with the decision in front of you and the information that matters.' },
  { t: 'Confidentiality', b: 'Nothing you share reaches your board, investors or team unless you decide it should.' },
];
---
<Layout faq={faq} title="Advisory | Sven Mulfinger" description="How 1:1 executive advisory with Sven Mulfinger works: who it is for, retainer and session cadence, what to expect, The Round and Kuma Partners, and a short FAQ.">
  <section class="container-x pt-14 md:pt-24 pb-16 md:pb-24">
    <p class="label text-steel">1:1 Executive Advisory</p>
    <h1 class="mt-8 display text-5xl md:text-7xl max-w-[16ch] text-balance">How we would work together.</h1>
    <p class="mt-8 max-w-[38rem] text-lg md:text-xl text-steel leading-relaxed">Confidential strategic counsel for the leader who carries the final call. This page answers the questions most leaders ask before a first conversation.</p>
    <nav aria-label="On this page" class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-steel">
      <a href="#who" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">Who this is for</a>
      <a href="#how" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">How it works</a>
      <a href="#expect" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">What to expect</a>
      <a href="#the-round" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">The Round and Kuma Partners</a>
      <a href="#faq" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">FAQ</a>
    </nav>
  </section>

  <!-- Who this is for -->
  <section id="who" class="border-t border-line scroll-mt-16">
    <div class="container-x py-20 md:py-28 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="label text-steel">01</p>
        <h2 class="mt-4 display text-4xl md:text-5xl">Who this is for.</h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <p class="text-lg text-steel leading-relaxed">Founders, scale-up CEOs and enterprise executives facing complexity that does not follow a straight line. Typically you already execute well. What has changed is the scale, the stakes or the people around you.</p>
        <ul class="mt-8 border-t border-line">
          {forWhom.map((f) => <li class="py-4 border-b border-line text-lg">{f}</li>)}
        </ul>
        <p class="mt-6 text-steel">Probably not a fit if you are looking for entry-level business coaching, therapy or a consulting report.</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="border-t border-line bg-mist scroll-mt-16">
    <div class="container-x py-20 md:py-28 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="label text-steel">02</p>
        <h2 class="mt-4 display text-4xl md:text-5xl">How an engagement works.</h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <dl class="border-t border-ink">
          {terms.map(([k, v]) => (
            <div class="grid sm:grid-cols-[11rem_1fr] gap-1 sm:gap-6 py-5 border-b border-line">
              <dt class="label text-steel pt-1">{k}</dt>
              <dd class="text-lg">{v}</dd>
            </div>
          ))}
        </dl>
        <ol class="mt-14 grid sm:grid-cols-2 gap-x-10 gap-y-10">
          {steps.map((s) => (
            <li class="border-t border-line pt-5">
              <p class="font-serif text-3xl text-steel/70">{s.n}</p>
              <h3 class="mt-4 text-xl">{s.t}</h3>
              <p class="mt-2 text-steel leading-relaxed">{s.b}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Expectations -->
  <section id="expect" class="border-t border-line scroll-mt-16">
    <div class="container-x py-20 md:py-28 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="label text-steel">03</p>
        <h2 class="mt-4 display text-4xl md:text-5xl">What to expect.</h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6 grid gap-10">
        {expectations.map((e) => (
          <div class="border-t border-ink pt-5">
            <h3 class="text-2xl">{e.t}</h3>
            <p class="mt-3 text-lg text-steel leading-relaxed">{e.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other paths -->
  <section id="the-round" class="bg-ink text-paper scroll-mt-16">
    <div class="container-x py-20 md:py-28 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="label text-fog">04</p>
        <h2 class="mt-4 display text-4xl md:text-5xl">When 1:1 is not the right room.</h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6 grid sm:grid-cols-2 gap-x-10 gap-y-12">
        <div class="border-t border-ink-line pt-5">
          <h3 class="text-2xl">The Round</h3>
          <p class="mt-3 text-fog leading-relaxed">A private, confidential peer group of founders and CEOs in Barcelona. Monthly sessions on live issues, individual sparring with me, a one-day, one-night immersion and an annual offsite. By application or peer nomination.</p>
          <a href={site.links.round} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-sm border-b border-ink-line pb-1 hover:border-paper transition-colors">theround.kuma.partners <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
        </div>
        <div class="border-t border-ink-line pt-5">
          <h3 class="text-2xl">Kuma Partners</h3>
          <p class="mt-3 text-fog leading-relaxed">When the friction sits between executives, the work moves to my institutional practice: team diagnostics, alignment sprints and strategic offsites with partners who have led companies themselves.</p>
          <a href={site.links.kuma} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-sm border-b border-ink-line pb-1 hover:border-paper transition-colors">kuma.partners <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
        </div>
      </div>
    </div>
  </section>

  <Faq tone="paper" heading="Before you get in touch." intro="Six questions leaders ask before a first conversation. Short answers first, the detail one click away." />
</Layout>
