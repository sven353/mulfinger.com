---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/faq';
import Chapter from '../components/Chapter.astro';
import Paths from '../components/Paths.astro';
import Invite from '../components/Invite.astro';

const forWhom = [
  'Founders whose company has outgrown the way they lead it',
  'Scale-up CEOs facing decisions only they can take',
  'Enterprise executives stepping into a bigger or different role',
  'Leaders whose team looks aligned in meetings but splinters in execution',
];

// Mirrors FAQ Q2 so the page and the schema say the same thing.
const workOn = [
  'A co-founder relationship that has quietly broken down',
  'An executive who no longer fits the stage of the company',
  'Decisions that keep landing back on your desk',
  'A strategy the team agrees with in the room and ignores outside it',
  'A board conversation you need to prepare',
  'Your own role changing as the company grows',
];

const terms = [
  ['Term', '6-month or 12-month retainer'],
  ['Sessions', 'Two working sessions of 60 to 90 minutes a month, fortnightly'],
  ['Where', 'Online, or in person in Barcelona or Madrid'],
  ['Between sessions', 'Direct priority access by voice or message when a decision cannot wait'],
  ['Also included', 'Periodic review of your key strategic documents'],
  ['Fees', 'Shared after the first conversation, once scope is clear'],
];

const steps = [
  { n: '01', t: 'First conversation', b: 'Confidential and exploratory. We look at the situation and decide together whether working together makes sense.' },
  { n: '02', t: 'Strategic Friction Diagnostic', b: 'If it does, we map what is really driving the situation and agree the outcomes we are aiming for.' },
  { n: '03', t: 'Working sessions', b: 'Fortnightly sessions on the live decisions, with direct access in between.' },
  { n: '04', t: 'Review', b: 'We review against the outcomes we set and decide together whether to continue, change course or stop.' },
];

const expectations = [
  { t: 'Mutual candour', b: 'I will tell you what I see, including the parts that are uncomfortable. I ask the same of you: bring the real issue rather than the presentable one.' },
  { t: 'Rigorous preparation', b: 'I prepare every session. You come with the decision in front of you and the information that matters.' },
  { t: 'Confidentiality', b: 'Nothing you share reaches your board, investors or team unless you decide it should.' },
];
---
<Layout faq={faq} title="Advisory | Sven Mulfinger" description="How 1:1 executive advisory with Sven Mulfinger works: who it is for, what we work on, retainer and session cadence, what to expect, The Round and Kuma Partners, and a short FAQ.">
  <!-- Opening: typographic, never animated -->
  <section aria-labelledby="advisory-heading">
    <div class="container-x pt-12 lg:pt-24 pb-12 lg:pb-16 lg:grid lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-3 lg:pt-4">
        <p class="label">1:1 Executive Advisory</p>
        <nav aria-label="On this page" class="mt-6 hidden lg:flex flex-col gap-1.5 text-[0.875rem]">
          <a href="#who" class="text-muted hover:text-ink">Who this is for</a>
          <a href="#how" class="text-muted hover:text-ink">How it works</a>
          <a href="#expect" class="text-muted hover:text-ink">What to expect</a>
          <a href="#the-round" class="text-muted hover:text-ink">The Round and Kuma Partners</a>
          <a href="#faq" class="text-muted hover:text-ink">FAQ</a>
        </nav>
      </div>
      <div class="mt-6 lg:mt-0 lg:col-span-9">
        <h1 id="advisory-heading" class="display text-[2.85rem] sm:text-[4rem] lg:text-[4.75rem] leading-[1.02] text-ink max-w-[16ch]">Confidential counsel for the decisions that carry consequences.</h1>
        <p class="mt-7 lg:mt-9 reading text-[1.25rem]! sm:text-[1.375rem]! leading-[1.5]! max-w-[38rem]">We work together over six or twelve months. Twice a month we sit down for 60 to 90 minutes on the decisions in front of you, in Barcelona, Madrid or online. In between, you can reach me directly when something cannot wait for the next session.</p>
        <div class="mt-8 lg:mt-10 flex flex-col sm:flex-row sm:items-center gap-x-6 gap-y-3">
          <a href="/contact" class="inline-flex justify-center items-center gap-2 bg-accent text-paper px-6 py-3.5 text-[0.9375rem] hover:bg-accent-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
          <span class="label">Confidential. Direct. No obligation to continue.</span>
        </div>
      </div>
    </div>
  </section>

  <Chapter id="who" note="Fit" heading="Who this is for, and what we work on.">
    <p class="mt-6 reading max-w-[38rem]">Typically you already execute well. What has changed is the scale, the stakes or the people around you.</p>
    <div class="mt-10 grid sm:grid-cols-2 gap-10 sm:gap-12">
      <div>
        <h3 class="text-[1.45rem] text-ink">Who this is for</h3>
        <ul class="mt-4 border-t border-line">
          {forWhom.map((f) => <li class="py-3 border-b border-line reading text-[1.0625rem]!">{f}</li>)}
        </ul>
        <p class="mt-4 label">Probably not a fit if you are looking for entry-level business coaching, therapy or a consulting report.</p>
      </div>
      <div>
        <h3 class="text-[1.45rem] text-ink">What we work on</h3>
        <ul class="mt-4 border-t border-line">
          {workOn.map((f) => <li class="py-3 border-b border-line reading text-[1.0625rem]!">{f}</li>)}
        </ul>
      </div>
    </div>
  </Chapter>

  <Chapter id="how" note="Engagement" heading="How an engagement works.">
    <dl class="mt-8 border-t border-line">
      {terms.map(([k, v]) => (
        <div class="py-4 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-8 border-b border-line">
          <dt class="label sm:pt-1">{k}</dt>
          <dd class="mt-1 sm:mt-0 reading text-ink!">{v}</dd>
        </div>
      ))}
    </dl>
    <h3 class="mt-14 text-[1.45rem] text-ink">The sequence</h3>
    <ol class="mt-4 border-t border-line">
      {steps.map((s, i) => (
        <li class="py-5 grid grid-cols-[2rem_1fr] gap-x-3 border-b border-line">
          <span class="font-serif text-[1.35rem] leading-snug text-muted">{i + 1}.</span>
          <div>
            <p class="font-serif text-[1.35rem] leading-snug text-ink">{s.t}</p>
            <p class="mt-1.5 reading">{s.b}</p>
          </div>
        </li>
      ))}
    </ol>
  </Chapter>

  <Chapter id="expect" note="Expectations" heading="What to expect.">
    <div class="mt-8 space-y-6 max-w-[38rem]">
      {expectations.map((e) => <p class="reading"><em class="text-ink">{e.t}.</em> {e.b}</p>)}
    </div>
  </Chapter>

  <Chapter id="the-round" headingId="paths-heading" note="Other rooms" heading="When 1:1 is not the right room.">
    <p class="mt-6 reading max-w-[38rem]">Which one fits depends on where the tension sits: in one leader, between peers or inside the executive team.</p>
    <Paths />
  </Chapter>

  <Faq heading="Before you get in touch." intro="Six questions leaders ask before a first conversation. Short answers first, the detail one click away." />

  <Invite />
</Layout>
