---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/faq';
import { site } from '../data/site';

const eyebrow = 'text-[11px] tracking-[0.18em] text-steel uppercase font-medium';

const forWhom = [
  'Founders whose company has outgrown the way they lead it',
  'Scale-up CEOs facing decisions only they can take',
  'Enterprise executives stepping into a bigger or different role',
  'Leaders whose team looks aligned in meetings but splinters in execution',
];

// Mirrors FAQ Q2 so the page and the schema say the same thing.
const workOn = [
  'A co-founder relationship that has quietly broken down',
  'An executive who no longer fits the stage of the company',
  'Decisions that keep landing back on your desk',
  'A strategy the team agrees with in the room and ignores outside it',
  'A board conversation you need to prepare',
  'Your own role changing as the company grows',
];

const terms = [
  ['Term', '6-month or 12-month retainer'],
  ['Sessions', 'Two working sessions of 60 to 90 minutes a month, fortnightly'],
  ['Where', 'Online, or in person in Barcelona or Madrid'],
  ['Between sessions', 'Direct priority access by voice or message when a decision cannot wait'],
  ['Also included', 'Periodic review of your key strategic documents'],
  ['Fees', 'Shared after the first conversation, once scope is clear'],
];

const steps = [
  { n: '01', t: 'First conversation', b: 'Confidential and exploratory. We look at the situation and decide together whether working together makes sense.' },
  { n: '02', t: 'Strategic Friction Diagnostic', b: 'If it does, we map what is really driving the situation and agree the outcomes we are aiming for.' },
  { n: '03', t: 'Working sessions', b: 'Fortnightly sessions on the live decisions, with direct access in between.' },
  { n: '04', t: 'Review', b: 'We review against the outcomes we set and decide together whether to continue, change course or stop.' },
];

const expectations = [
  { t: 'Mutual candour', b: 'I will tell you what I see, including the parts that are uncomfortable. I ask the same of you: bring the real issue rather than the presentable one.' },
  { t: 'Rigorous preparation', b: 'I prepare every session. You come with the decision in front of you and the information that matters.' },
  { t: 'Confidentiality', b: 'Nothing you share reaches your board, investors or team unless you decide it should.' },
];
---
<Layout faq={faq} title="Advisory | Sven Mulfinger" description="How 1:1 executive advisory with Sven Mulfinger works: who it is for, what we work on, retainer and session cadence and what to expect.">
  <!-- Hero: same diagonal backdrop as the homepage; never animated -->
  <section class="bg-linear-to-tr from-[#FAF9F6] via-[#F5F4EE] to-[#ECEAE6]">
    <div class="container-x pt-14 md:pt-24 pb-16 md:pb-24">
      <div class="max-w-3xl">
        <p class={eyebrow}>Executive advisory · Engagement model</p>
        <h1 class="mt-4 md:mt-6 font-serif text-4xl md:text-5xl lg:text-[3.6rem] leading-[1.1] tracking-[-0.01em] text-ink text-balance">Confidential counsel for the decisions that carry consequences.</h1>
        <p class="mt-6 md:mt-8 max-w-[38rem] text-base lg:text-lg text-steel leading-relaxed">We work together over six or twelve months. Twice a month we sit down for 60 to 90 minutes on the decisions in front of you, in Barcelona, Madrid or online. In between, you can reach me directly when something cannot wait for the next session.</p>
        <div class="mt-8 md:mt-10">
          <a href="/contact" class="inline-flex items-center gap-2 whitespace-nowrap rounded-sm bg-ink text-paper px-6 py-3.5 text-sm hover:bg-ink-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
          <span class="mt-3 block text-xs text-steel">Confidential. Direct. No obligation to continue.</span>
        </div>
      </div>
      <nav aria-label="On this page" class="mt-12 md:mt-16 pt-6 border-t border-line flex flex-wrap gap-x-6 gap-y-2 text-sm text-steel">
        <a href="#who" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">Who this is for</a>
        <a href="#how" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">How it works</a>
        <a href="#expect" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">What to expect</a>
        <a href="#the-round" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">The Round and Kuma Partners</a>
        <a href="#faq" class="border-b border-line-strong pb-0.5 hover:text-ink hover:border-ink">FAQ</a>
      </nav>
    </div>
  </section>

  <!-- Who this is for / What we work on: two-column editorial grid -->
  <section id="who" class="bg-paper border-t border-line scroll-mt-16" aria-labelledby="who-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class={eyebrow}>Fit</p>
        <h2 id="who-heading" class="mt-2 mb-4 font-serif text-3xl md:text-4xl text-ink">Who this is for, and what we work on.</h2>
        <p class="max-w-2xl text-lg text-ink/80 leading-relaxed">Typically you already execute well. What has changed is the scale, the stakes or the people around you.</p>
      </div>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
        <div class="reveal delay-100 border-t border-line-strong pt-5">
          <span class="block font-mono text-xs text-steel/70 tabular-nums">01</span>
          <h3 class="mt-3 font-serif text-xl md:text-2xl text-ink">Who this is for</h3>
          <ul class="mt-5 border-t border-line">
            {forWhom.map((f) => <li class="py-3.5 border-b border-line text-steel leading-relaxed">{f}</li>)}
          </ul>
          <p class="mt-5 text-sm text-steel">Probably not a fit if you are looking for entry-level business coaching, therapy or a consulting report.</p>
        </div>
        <div class="reveal delay-200 border-t border-line-strong pt-5">
          <span class="block font-mono text-xs text-steel/70 tabular-nums">02</span>
          <h3 class="mt-3 font-serif text-xl md:text-2xl text-ink">What we work on</h3>
          <ul class="mt-5 border-t border-line">
            {workOn.map((f) => <li class="py-3.5 border-b border-line text-steel leading-relaxed">{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How an engagement works -->
  <section id="how" class="bg-mist border-t border-line scroll-mt-16" aria-labelledby="how-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class={eyebrow}>Engagement</p>
        <h2 id="how-heading" class="mt-2 mb-10 font-serif text-3xl md:text-4xl text-ink">How an engagement works.</h2>
      </div>
      <dl class="reveal delay-100 border-t border-line-strong">
        {terms.map(([k, v]) => (
          <div class="grid sm:grid-cols-[13rem_1fr] gap-1 sm:gap-8 py-4 border-b border-line">
            <dt class="text-[11px] tracking-[0.14em] uppercase font-medium text-steel pt-1">{k}</dt>
            <dd class="text-ink">{v}</dd>
          </div>
        ))}
      </dl>
      <ol class="mt-14 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {steps.map((s, i) => (
          <li class:list={['reveal border-t border-line-strong pt-4', i > 0 && `delay-${Math.min(i, 3) * 100}`]}>
            <span class="block font-mono text-xs text-steel/70 tabular-nums">{s.n}</span>
            <h3 class="mt-3 font-serif text-xl text-ink leading-snug">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- What to expect -->
  <section id="expect" class="bg-paper border-t border-line scroll-mt-16" aria-labelledby="expect-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class={eyebrow}>Expectations</p>
        <h2 id="expect-heading" class="mt-2 mb-10 font-serif text-3xl md:text-4xl text-ink">What to expect.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 pt-8 border-t border-line">
        {expectations.map((e, i) => (
          <div class:list={['reveal', `delay-${(i + 1) * 100}`]}>
            <h3 class="mb-3 font-serif text-xl md:text-2xl text-ink leading-snug">{e.t}</h3>
            <p class="text-sm leading-relaxed text-steel">{e.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ecosystem: three paths, same card system as the homepage -->
  <section id="the-round" class="bg-paper border-t border-line scroll-mt-16" aria-labelledby="paths-heading">
    <div class="container-x py-16 md:py-24">
      <div class="reveal">
        <p class={eyebrow}>Three paths</p>
        <h2 id="paths-heading" class="mt-2 mb-4 font-serif text-3xl md:text-4xl text-ink">When 1:1 is not the right room.</h2>
        <p class="max-w-2xl text-lg text-ink/80 leading-relaxed">Which one fits depends on where the tension sits: in one leader, between peers or inside the executive team.</p>
      </div>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <article class="reveal delay-100 flex flex-col justify-between rounded-2xl md:rounded-[1.5rem] border border-line-strong bg-mist p-8 shadow-sm">
          <div>
            <p class={eyebrow}>Primary · Individual</p>
            <h3 class="mt-5 font-serif text-2xl md:text-[1.75rem] text-ink leading-snug">1:1 Advisory</h3>
            <p class="mt-4 text-sm leading-relaxed text-steel">Confidential counsel for the leader carrying the final call. Six or twelve months, two sessions a month and direct access in between.</p>
          </div>
          <a href="/contact" class="mt-8 inline-flex items-center gap-2 self-start rounded-sm bg-ink text-paper px-5 py-3 text-sm hover:bg-ink-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
        </article>
        <article class="reveal delay-200 flex flex-col justify-between rounded-2xl md:rounded-[1.5rem] border border-ink/5 bg-white p-8 shadow-sm">
          <div>
            <p class={eyebrow}>Peer group · Barcelona</p>
            <h3 class="mt-5 font-serif text-2xl md:text-[1.75rem] text-ink leading-snug">The Round</h3>
            <p class="mt-4 text-sm leading-relaxed text-steel">A private, confidential peer group of founders and CEOs in Barcelona. Monthly sessions on live issues, individual sparring with me, a one-day, one-night immersion and an annual offsite. By application or peer nomination.</p>
          </div>
          <a href={site.links.round} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-1.5 self-start text-sm border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">theround.kuma.partners <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
        </article>
        <article class="reveal delay-300 flex flex-col justify-between rounded-2xl md:rounded-[1.5rem] border border-ink/5 bg-white p-8 shadow-sm">
          <div>
            <p class={eyebrow}>Leadership teams</p>
            <h3 class="mt-5 font-serif text-2xl md:text-[1.75rem] text-ink leading-snug">Kuma Partners</h3>
            <p class="mt-4 text-sm leading-relaxed text-steel">When the friction sits between executives, the work moves to my institutional practice: team diagnostics, alignment sprints and strategic offsites with partners who have led companies themselves.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm">
            <a href={site.links.kuma} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">kuma.partners <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
            <a href={site.links.offsite} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border-b border-ink pb-1 hover:text-steel hover:border-steel transition-colors">Offsites <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <Faq tone="mist" heading="Before you get in touch." intro="Six questions leaders ask before a first conversation. Short answers first, the detail one click away." />
</Layout>
