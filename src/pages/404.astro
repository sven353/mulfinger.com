---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Sven Mulfinger" noindex>
  <section class="container-x py-32 md:py-44 max-w-3xl">
    <p class="label text-steel">404</p>
    <h1 class="mt-6 display text-5xl md:text-6xl">This page is not here.</h1>
    <p class="mt-6 reading">It may have moved when the site was rebuilt.</p>
    <a href="/" class="mt-10 inline-block link text-[0.9375rem]">Go to the homepage</a>
  </section>
</Layout>
