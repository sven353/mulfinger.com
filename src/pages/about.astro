---
import Layout from '../layouts/Layout.astro';
import Chapter from '../components/Chapter.astro';
import Invite from '../components/Invite.astro';
import { whoIs, training, profileUpdated } from '../data/site';

// The three pillars, aligned with the homepage background section.
const pillars = [
  {
    n: '01',
    title: 'Entrepreneurial leadership',
    body: "Twenty years building companies, as a founder and as a CEO inside a corporate group. I co-founded Diana Media Group and trnd in Southern Europe, where Bertelsmann’s Gruner + Jahr took a stake in 2014 and the majority in 2016, then led TERRITORY Influence for Western and Southern Europe within Bertelsmann. After that I co-founded Dana, a digital platform for women’s mental health, and then Kuma Partners. I know what it is to carry the whole company, including the parts that never reach the pitch deck."
  },
  {
    n: '02',
    title: 'Executive and international practice',
    body: 'Advising founders and CEOs since 2017, with executive coaching as the main focus since 2023. Over 100 founders, managing directors and C-suite leaders guided across 1:1 advisory, executive peer councils and board-level interventions throughout Europe, in English, Spanish, German and French.',
  },
  {
    n: '03',
    title: 'Academic research and governance',
    body: 'At IESE Business School since 2014. Prof. Thomas Klueter and I built a teaching case on the choices I faced before founding trnd, and every year I join the MBA and Executive MBA classes that discuss it. Prof. Iñigo Gallo’s IESE case on the Royco Minute Soup campaign, a project I led at trnd, is distributed through Harvard Business Publishing. Today, with Prof. Klueter and Prof. Dr. Nicolas Deuschel (IE Business School), I study how founders with non-linear minds lead and govern. My recent work focuses on cognitive preferences, within and beyond the neurodivergent spectrum, and their effect on leadership.',
  },
];

const lineage = [
  { stage: 'Science', text: 'Molecular genetics, then a doctorate in engineering (Dr.-Ing.) at the Technische Universität München, Weihenstephan (1996 to 1999), on PCR-based detection of fungal infections in malt and cereals. Genetics taught me that the visible trait is rarely where the cause sits; engineering added process thinking: flows, feedback loops, bottlenecks and failure modes.' },
  { stage: 'European institutions', text: 'Both my parents worked for the EU institutions and I went to the European School in Brussels. I learned early that most conflict between capable people comes from different operating assumptions rather than bad intent.' },
  { stage: 'Operator', text: "International sales at Wacker Chemie (2000 to 2004). Co-founder and CEO of Diana Media Group (2005 to 2009) and of trnd in Southern Europe (2009 to 2018) and France (2010 to 2014). Gruner + Jahr, part of Bertelsmann, took 50% of trnd in 2014 and 75% in 2016. CEO Western and Southern Europe at TERRITORY Influence, Bertelsmann (2018 to 2020). Co-founder, CXO and CSO of Dana, women’s mental health (2020 to 2023). I know both seats from the inside." },
  { stage: 'IESE and IE Business School', text: 'Guest speaker since 2014. With Prof. Thomas Klueter I built a teaching case on the choices I faced before founding trnd. Every year I join the MBA and Executive MBA sessions as its protagonist, including the Munich Executive MBA cohort. Today I research neurodivergent founders and CEOs with Prof. Thomas Klueter (IESE) and Prof. Nicolas Deuschel (IE Business School).' },
  { stage: 'Executive advisory', text: `Founding Partner at Kuma Partners. Advising founders and CEOs since 2017, with executive coaching as the main focus since 2023. Over 100 founders, managing directors and C-suite leaders guided across 1:1 advisory, executive peer councils and board-level interventions, in four working languages. ${training}` },
];

const foundations = [
  { t: 'Co-creation', b: 'You know your company. I bring pattern recognition from many others. The answer is built together, and you own it.' },
  { t: 'Courage', b: 'I will say what others in the room cannot or will not. That includes the part of the problem that sits with you.' },
  { t: 'Principled tension', b: 'Some tensions should not be resolved quickly. I hold them open long enough for a better decision to emerge.' },
  { t: 'Absolute integrity', b: 'Confidentiality is total. I do not take work where my interests and yours could pull apart, and I say so when something is outside my competence.' },
];
// IESE in the classroom: dated, checkable sources (posts read 2026-11-08; dates from the posts).
const ieseSources = [
  { when: 'October 2026', text: 'Two IESE MBA cohorts discuss the case. My wife joins me on stage to tell the side that never makes it into a case study.', label: 'LinkedIn post: “Who pays the bill when a founder decides to be bold?”', href: 'https://www.linkedin.com/feed/update/urn:li:activity:7515675449616670720/' },
  { when: 'September 2025', text: 'The Executive MBA cohort from Munich works through the case with Prof. Klueter and me.', label: 'LinkedIn post on the Executive MBA session', href: 'https://www.linkedin.com/feed/update/urn:li:activity:7377291193908350976/' },
  { when: 'October 2024', text: 'Two IESE MBA classes analyse my entrepreneurial path, including the decision to sell a start-up for one euro.', label: 'LinkedIn post on the MBA sessions, with Prof. Klueter’s comment', href: 'https://www.linkedin.com/feed/update/urn:li:activity:7255632213247950848/' },
  { when: 'September 2023', text: 'MBA and Executive MBA classes on the choices I faced before founding trnd: entrepreneurship or a corporate career, and what it means for a family.', label: 'LinkedIn post on the case and how it began', href: 'https://www.linkedin.com/feed/update/urn:li:activity:7113540496374870016/' },
  { when: '2014', text: 'Prof. Iñigo Gallo’s IESE case on the Royco Minute Soup word-of-mouth campaign, a project I led at trnd.', label: 'Harvard Business Publishing listing (IES325)', href: 'https://store.hbr.org/product/repositioning-royco-minute-soup-evaluating-a-word-of-mouth-campaign/IES325' },
];
---
<Layout title="About Dr. Sven Mulfinger | Career and research" type="profile" description="Serial entrepreneur and CEO with a Dr.-Ing. from TUM: Sven Mulfinger's career at trnd, Bertelsmann and Dana, IESE teaching since 2014 and research with IE.">
  <!-- Opening: typographic, never animated -->
  <section aria-labelledby="about-heading">
    <div class="container-x pt-12 lg:pt-24 pb-12 lg:pb-16 lg:grid lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-3 lg:pt-4"><p class="secnum">Background and perspective</p></div>
      <div class="mt-6 lg:mt-0 lg:col-span-9">
        <h1 id="about-heading" class="rise rise-2 display text-[2.85rem] sm:text-[4rem] lg:text-[4.75rem] leading-[1.02] text-ink max-w-[15ch]">Sitting on both sides of the table.</h1>
        <p class="rise rise-3 mt-7 lg:mt-9 reading text-ink! text-[1.25rem]! sm:text-[1.375rem]! leading-[1.5]! max-w-[38rem]">{whoIs}</p>
        <p class="rise rise-3 mt-5 reading max-w-[38rem]">I trained as a scientist in molecular genetics and engineering. I then founded and built companies and carried the decisions that come with them. Today I bring both to founders and CEOs: an engineer's habit of looking for the structure underneath the symptom, and a founder's memory of how lonely the final call can be.</p>
      </div>
    </div>
  </section>

  <Chapter id="pillars" note="Experience and research" heading="Three sources of judgement.">
    <div class="mt-8 space-y-6 max-w-[38rem]">
      {pillars.map((p) => <p class="settle reading"><em class="text-ink">{p.title}.</em> {p.body}</p>)}
    </div>
  </Chapter>

  <Chapter id="lineage" note="The path here" heading="From genetics to the C-suite.">
    <ol class="mt-8 hair-t ">
      {lineage.map((l) => (
        <li class="settle py-6 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-8 hair-b ">
          <h3 class="text-[1.35rem] leading-snug text-ink">{l.stage}</h3>
          <p class="mt-2 sm:mt-0 reading">{l.text}</p>
        </li>
      ))}
    </ol>
  </Chapter>

  <Chapter id="iese" note="At IESE" heading="In the classroom at IESE.">
    <p class="mt-8 reading max-w-[38rem]">I first spoke at IESE Business School at an entrepreneurship panel in 2014. <a href="https://www.iese.edu/faculty-research/faculty/thomas-maximilian-klueter/" target="_blank" rel="noopener noreferrer" class="link">Prof. Thomas Klueter<span class="sr-only"> (opens in a new tab)</span></a> and I then built a teaching case on the choices I faced before founding trnd. It has been taught every year since in the MBA and Executive MBA. I sit at the back of the room while the class debates my decisions, then step forward as the protagonist.</p>
    <ol class="mt-8 hair-t">
      {ieseSources.map((x) => (
        <li class="settle py-6 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-8 hair-b">
          <p class="label sm:pt-1.5">{x.when}</p>
          <div class="mt-2 sm:mt-0">
            <p class="reading">{x.text}</p>
            <p class="mt-2 text-[0.9375rem]"><a href={x.href} target="_blank" rel="noopener noreferrer" class="link">{x.label}<span class="sr-only"> (opens in a new tab)</span></a></p>
          </div>
        </li>
      ))}
    </ol>
  </Chapter>

  <Chapter id="lenses" note="The intersection" heading="Neuroscience, organisations and governance.">
    <div class="mt-8 space-y-5 max-w-[38rem]">
      <p class="reading">Three lenses run through everything I do. Neuroscience explains what happens to judgement under pressure: why smart people narrow their options, defend positions and avoid the conversation that matters. Organisational behaviour explains how those individual patterns harden into team habits. Governance is where the fix usually lives, in who decides what, with which information and by when.</p>
      <p class="reading">Most interventions stay in one lens. Coaching works on the individual and leaves the structure untouched. Consulting redesigns the structure and ignores the people who have to live in it. I work across all three, because the friction a CEO feels personally is usually the same friction the organisation produces structurally.</p>
      <p class="reading">I keep the jargon out of the room. The measure of the work is simple: you decide better, faster and with less collateral damage than before.</p>
    </div>
  </Chapter>

  <Chapter id="foundations" note="Core foundation" heading="What you can hold me to.">
    <dl class="mt-8 hair-t ">
      {foundations.map((f) => (
        <div class="settle py-6 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-8 hair-b ">
          <dt class="font-serif text-[1.35rem] leading-snug text-ink">{f.t}</dt>
          <dd class="mt-2 sm:mt-0 reading">{f.b}</dd>
        </div>
      ))}
    </dl>
  </Chapter>

  <p class="container-x pb-10 text-[0.8125rem] text-muted">Last updated <time datetime={profileUpdated.iso}>{profileUpdated.label}</time></p>

  <Invite heading="Bring the decision you have been circling." body="A first conversation is confidential and exploratory. If I am not the right person for what you describe, I will say so." />
</Layout>
