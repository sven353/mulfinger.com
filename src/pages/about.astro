---
import Layout from '../layouts/Layout.astro';
import Chapter from '../components/Chapter.astro';
import Invite from '../components/Invite.astro';

// The three pillars, aligned with the homepage background section.
const pillars = [
  {
    n: '01',
    title: 'Entrepreneurial leadership',
    body: "Firsthand responsibility for founding and building companies: four years on MaterFly, the venture in women's mental health that became Dana, then founding Kuma Partners. I know what it is to carry the whole company, including the parts that never reach the pitch deck.",
  },
  {
    n: '02',
    title: 'Executive and international practice',
    body: 'Over 100 founders, managing directors and C-suite leaders guided across 1:1 advisory, executive peer councils and board-level interventions throughout Europe, in English, Spanish, German and French.',
  },
  {
    n: '03',
    title: 'Academic research and governance',
    body: 'Research with IESE Business School since a 2015 case study with Prof. Iñigo Gallo. Today, with Prof. Dr. Thomas Kluetter (IESE Business School) and Prof. Dr. Nicolas Deuschel (IE Business School), I study how founders with non-linear minds lead and govern.',
  },
];

const lineage = [
  { n: '01', stage: 'Molecular genetics', text: 'My first discipline. Genetics teaches you that complex outcomes come from small rules interacting at scale, and that the visible trait is rarely where the cause sits.' },
  { n: '02', stage: 'Chemical engineering', text: 'Engineering added process thinking: flows, feedback loops, bottlenecks and failure modes. I hold a doctorate, and I still look at an organisation the way an engineer looks at a plant.' },
  { n: '03', stage: 'European institutions', text: 'Both my parents worked for the EU institutions and I went to the European School in Brussels. I learned early that most conflict between capable people comes from different operating assumptions rather than bad intent.' },
  { n: '04', stage: 'Founder', text: "Four years building MaterFly, which became Dana, a venture in women's mental health. I know the founder seat from the inside, including the parts nobody posts about." },
  { n: '05', stage: 'IESE and IE Business School', text: 'Research and teaching since a 2015 case study with Prof. Iñigo Gallo. Today I research neurodivergent founders and CEOs with Prof. Thomas Kluetter (IESE) and Prof. Nicolas Deuschel (IE Business School).' },
  { n: '06', stage: 'Executive advisory', text: 'Lead Partner at Kuma Partners. Over 100 founders, managing directors and C-suite leaders guided across 1:1 advisory, executive peer councils and board-level interventions, in four working languages, from early scale-ups to established leadership teams.' },
];

const foundations = [
  { t: 'Co-creation', b: 'You know your company. I bring pattern recognition from many others. The answer is built together, and you own it.' },
  { t: 'Courage', b: 'I will say what others in the room cannot or will not. That includes the part of the problem that sits with you.' },
  { t: 'Principled tension', b: 'Some tensions should not be resolved quickly. I hold them open long enough for a better decision to emerge.' },
  { t: 'Absolute integrity', b: 'Confidentiality is total. I do not take work where my interests and yours could pull apart, and I say so when something is outside my competence.' },
];
---
<Layout title="About | Sven Mulfinger" type="profile" description="From molecular genetics and chemical engineering to founding companies and international executive advisory. Sven Mulfinger's background, research with IESE and IE Business School and the foundations of his work.">
  <!-- Opening: typographic, never animated -->
  <section aria-labelledby="about-heading">
    <div class="container-x pt-12 lg:pt-24 pb-12 lg:pb-16 lg:grid lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-3 lg:pt-4"><p class="label">Background and perspective</p></div>
      <div class="mt-6 lg:mt-0 lg:col-span-9">
        <h1 id="about-heading" class="rise rise-2 display text-[2.85rem] sm:text-[4rem] lg:text-[4.75rem] leading-[1.02] text-ink max-w-[15ch]">Sitting on both sides of the table.</h1>
        <p class="rise rise-3 mt-7 lg:mt-9 reading text-[1.25rem]! sm:text-[1.375rem]! leading-[1.5]! max-w-[38rem]">I trained as a scientist in molecular genetics and chemical engineering and hold a doctorate. I then founded and built companies and carried the decisions that come with them. Today I bring both to founders and CEOs: an engineer's habit of looking for the structure underneath the symptom, and a founder's memory of how lonely the final call can be.</p>
      </div>
    </div>
  </section>

  <Chapter id="pillars" note="Experience and research" heading="Three sources of judgement.">
    <div class="mt-8 space-y-6 max-w-[38rem]">
      {pillars.map((p) => <p class="settle reading"><em class="text-ink">{p.title}.</em> {p.body}</p>)}
    </div>
  </Chapter>

  <Chapter id="lineage" note="The path here" heading="From genetics to the C-suite.">
    <ol class="mt-8 border-t border-line">
      {lineage.map((l) => (
        <li class="settle py-6 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-8 border-b border-line">
          <h3 class="text-[1.35rem] leading-snug text-ink">{l.stage}</h3>
          <p class="mt-2 sm:mt-0 reading">{l.text}</p>
        </li>
      ))}
    </ol>
  </Chapter>

  <Chapter id="lenses" note="The intersection" heading="Neuroscience, organisations and governance.">
    <div class="mt-8 space-y-5 max-w-[38rem]">
      <p class="reading">Three lenses run through everything I do. Neuroscience explains what happens to judgement under pressure: why smart people narrow their options, defend positions and avoid the conversation that matters. Organisational behaviour explains how those individual patterns harden into team habits. Governance is where the fix usually lives, in who decides what, with which information and by when.</p>
      <p class="reading">Most interventions stay in one lens. Coaching works on the individual and leaves the structure untouched. Consulting redesigns the structure and ignores the people who have to live in it. I work across all three, because the friction a CEO feels personally is usually the same friction the organisation produces structurally.</p>
      <p class="reading">I keep the jargon out of the room. The measure of the work is simple: you decide better, faster and with less collateral damage than before.</p>
    </div>
  </Chapter>

  <Chapter id="foundations" note="Core foundation" heading="What you can hold me to.">
    <dl class="mt-8 border-t border-line">
      {foundations.map((f) => (
        <div class="settle py-6 sm:grid sm:grid-cols-[12rem_1fr] sm:gap-8 border-b border-line">
          <dt class="font-serif text-[1.35rem] leading-snug text-ink">{f.t}</dt>
          <dd class="mt-2 sm:mt-0 reading">{f.b}</dd>
        </div>
      ))}
    </dl>
  </Chapter>

  <Invite heading="Bring the decision you have been circling." body="A first conversation is confidential and exploratory. If I am not the right person for what you describe, I will say so." />
</Layout>
