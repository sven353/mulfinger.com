---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank you | Sven Mulfinger" noindex>
  <section class="container-x py-32 md:py-44 max-w-3xl">
    <p class="label text-steel">Received</p>
    <h1 class="mt-6 display text-5xl md:text-6xl">Thank you. I will read this myself.</h1>
    <p class="mt-6 reading">You will hear from me within 24 to 48 hours.</p>
    <a href="/" class="mt-10 inline-block link text-[0.9375rem]">Back to the homepage</a>
  </section>
</Layout>
