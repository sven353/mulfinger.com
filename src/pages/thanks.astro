---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank you | Sven Mulfinger" noindex>
  <section class="container-x py-32 md:py-44 max-w-3xl">
    <p class="label text-steel">Received</p>
    <h1 class="mt-6 display text-5xl md:text-6xl">Thank you. I will read this personally.</h1>
    <p class="mt-6 text-lg text-steel">You will hear from me within a few working days.</p>
    <a href="/" class="mt-10 inline-block text-sm border-b border-ink pb-1 hover:text-steel hover:border-steel">Back to the homepage</a>
  </section>
</Layout>
