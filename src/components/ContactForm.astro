---
// Netlify Form "executive-diagnostic".
// Netlify detects it at deploy time from the static HTML (data-netlify="true").
// With JavaScript: /form.js submits via fetch and shows the in-place confirmation below.
// Without JavaScript: the browser posts normally and Netlify redirects to /thanks.
// Submissions: Netlify > Project > Forms > executive-diagnostic.
// compact: the short version inside the petrol invite band (name, email, message), posted as "first-conversation".
import { legal as L } from '../data/legal';
import { formText } from '../data/formText';
import type { Lang } from '../data/i18n';
interface Props { compact?: boolean; lang?: Lang }
const { compact = false, lang = 'en' } = Astro.props;
// The short form speaks the page language; the full form on /contact stays in English.
const t = formText[compact ? lang : 'en'];
const fill = (x: string) => x.replace('{owner}', L.owner).replace('{email}', L.email);
const formName = compact ? 'first-conversation' : 'executive-diagnostic';
const id = (k: string) => (compact ? `fc-${k}` : k);
const field = compact
  ? 'peer w-full bg-white text-[#23262a] px-4 py-3.5 text-base outline-none placeholder:text-[#5e6266] focus:outline-2 focus:outline-offset-2 focus:outline-white aria-[invalid=true]:outline-2 aria-[invalid=true]:outline-[#ffb4a6]'
  : 'peer w-full bg-white hair-all focus:hair-accent px-4 py-3.5 text-base outline-none transition-shadow placeholder:text-steel/60 aria-[invalid=true]:hair-red';
const lbl = 'block mb-2 text-sm font-medium text-ink';
const err = compact ? 'mt-2 text-sm text-[#ffd2c7] hidden' : 'mt-2 text-sm text-red-700 hidden';
const submitLabel = compact ? t.submit : 'Send';
const btn = compact ? 'bg-[#eceae5] text-[#3e5566] hover:bg-white font-medium' : 'bg-ink text-paper hover:bg-ink-hover font-medium';
---
<div data-form-root>
  <form
    name={formName}
    method="POST"
    action="/thanks"
    data-netlify="true"
    netlify-honeypot="bot-field"
    novalidate
    class="grid gap-6"
    aria-describedby={id("form-note")}
    data-submit-text={submitLabel}
    data-sending-text={t.sending}
  >
    <input type="hidden" name="form-name" value={formName} />
    {compact && <input type="hidden" name="page_language" value={lang} />}
    <p class="hidden" aria-hidden="true">
      <label>Do not fill this in: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="grid sm:grid-cols-2 gap-6">
      <div>
        <label for={id("full_name")} class={lbl}>{t.name} <span class="sr-only">{t.req}</span></label>
        <input id={id("full_name")} name="full_name" type="text" required minlength="2" maxlength="120" autocomplete="name" aria-describedby={id("full_name-error")} class={field} />
        <p id={id("full_name-error")} class={err} data-error>{t.nameErr}</p>
      </div>
      <div>
        <label for={id("email")} class={lbl}>{compact ? t.email : 'Professional or direct email'} <span class="sr-only">{t.req}</span></label>
        <input id={id("email")} name="email" type="email" required maxlength="160" autocomplete="email" inputmode="email" aria-describedby={id("email-error")} class={field} />
        <p id={id("email-error")} class={err} data-error>{t.emailErr}</p>
      </div>
    </div>
    {!compact && (<div>
      <label for={id("role")} class={lbl}>Role and organisation <span class="sr-only">(required)</span></label>
      <input id={id("role")} name="role_organisation" type="text" required minlength="2" maxlength="200" autocomplete="organization-title" placeholder="CEO, Acme Robotics" aria-describedby={id("role-error")} class={field} />
      <p id={id("role-error")} class={err} data-error>Please tell me your role and organisation.</p>
    </div>)}
    <div>
      <label for={id("challenge")} class={lbl}>{compact ? t.msg : 'The decision or challenge occupying your attention'} <span class="sr-only">{t.req}</span></label>
      <textarea id={id("challenge")} name="decision_challenge" rows={compact ? 4 : 6} required minlength="20" maxlength="4000" placeholder={compact ? t.msgPh : 'A few sentences is enough.'} aria-describedby={id("challenge-error")} class={field + ' resize-y'}></textarea>
      <p id={id("challenge-error")} class={err} data-error>{t.msgErr}</p>
    </div>

    <!-- First-layer data protection information (GDPR Art. 13, AEPD layered model) -->
    <details class="hair-all bg-mist text-[0.8125rem] lg:text-xs text-steel">
      <summary class="cursor-pointer px-4 py-3 text-[0.8125rem] lg:text-xs font-medium text-steel">{t.dp}</summary>
      <dl class="grid grid-cols-[7rem_1fr] gap-x-4 gap-y-2 px-4 pb-4 leading-relaxed">
        {t.dpRows.map(([k, v]) => <><dt class="font-medium text-ink">{k}</dt><dd>{fill(v)}</dd></>)}
        <dt class="font-medium text-ink">{t.dpMoreLabel}</dt><dd>{t.dpMorePre}<a href="/privacy" class="hair-u hover:text-ink">{t.dpMoreLink}</a>{t.dpMorePost}</dd>
      </dl>
    </details>

    <div>
      <label class="flex items-start gap-3 text-sm text-steel leading-relaxed cursor-pointer">
        <input id={id("privacy_consent")} name="privacy_consent" type="checkbox" value="accepted" required aria-describedby={id("privacy_consent-error")} class="mt-0.5 size-4 shrink-0 accent-[var(--color-ink)] aria-[invalid=true]:outline aria-[invalid=true]:outline-red-700" />
        <span>{t.consentPre}<a href="/privacy" class="hair-u text-ink">{t.consentLink}</a>{t.consentPost} <span class="sr-only">{t.req}</span></span>
      </label>
      <p id={id("privacy_consent-error")} class={err} data-error>{t.consentErr}</p>
    </div>

    <div class={compact ? "flex flex-col-reverse items-stretch sm:items-start gap-4 pt-2" : "flex flex-col sm:flex-row sm:items-center gap-6 justify-between pt-2"}>
      <p id={id("form-note")} class="text-[0.8125rem] lg:text-xs text-steel max-w-sm leading-relaxed">{compact ? t.note : 'Read by Sven personally and treated as confidential.'}</p>
      <button type="submit" data-submit class={`shrink-0 sm:whitespace-nowrap ${btn} px-8 py-4 text-[0.9375rem] disabled:opacity-60 disabled:cursor-wait transition-colors inline-flex items-center justify-center gap-3`}>
        <span data-submit-label>{submitLabel}</span> <span aria-hidden="true">→</span>
      </button>
    </div>
    <p data-form-error role="alert" class={compact ? 'hidden bg-white px-4 py-3 text-sm text-red-700' : 'hidden hair-all hair-red px-4 py-3 text-sm text-red-700'}>{t.failure}</p>
  </form>

  <div data-form-success hidden tabindex="-1" role="status" aria-live="polite" class="outline-none">
    <p class="label text-steel">{t.okLabel}</p>
    <p class="mt-4 display text-4xl md:text-5xl">{t.okTitle}</p>
    <p class="mt-6 text-steel leading-relaxed max-w-md">{t.okBody}</p>
    <div class="mt-10 pt-6 hair-t flex flex-col sm:flex-row gap-x-8">
      {t.okLinks.map(([h, l]) => <a href={h} class="link py-3 text-[0.9375rem]">{l}</a>)}
    </div>
  </div>
</div>

<script is:inline src="/form.js" defer></script>
