---
// Colophon-style footer on paper. The credentials line replaces the old proof bar.
import { site } from '../data/site';
const year = new Date().getFullYear();
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---
<footer class="mt-auto">
  <div class="container-x">
    <div class="hair-t hair-strong pt-12 pb-10 lg:grid lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-3">
        <p class="font-serif text-[1.4rem] text-ink">Sven Mulfinger</p>
        <p class="mt-2 label">Executive advisory for founders and CEOs. Based in Barcelona.</p>
      </div>
      <div class="mt-8 lg:mt-0 lg:col-span-5">
        <p class="reading text-[1.0625rem]! leading-relaxed">
          Serial entrepreneur and CEO<span class="text-line-strong" aria-hidden="true"> · </span>More than 100 founders, managing directors and C-suite leaders guided<span class="text-line-strong" aria-hidden="true"> · </span>Research collaborator with IESE and IE Business School
        </p>
        <p class="mt-2 label">In person in Barcelona, Madrid, Munich and Brussels, online across the world, in English, Spanish, German and French.</p>
      </div>
      <nav aria-label="Footer" class="mt-8 lg:mt-0 lg:col-span-2 text-[0.875rem]">
        <ul class="space-y-2">
          <li><a class="text-steel hover:text-ink" href="/about">About</a></li>
          <li><a class="text-steel hover:text-ink" href="/advisory">Advisory</a></li>
          <li><a class="text-steel hover:text-ink" href="/#research">Research</a></li>
          <li><a class="text-steel hover:text-ink" href="/contact">Contact</a></li>
        </ul>
      </nav>
      <div class="mt-6 lg:mt-0 lg:col-span-2 text-[0.875rem]">
        <ul class="space-y-2">
          <li><a class="text-steel hover:text-ink" href={site.links.kuma} {...ext}>Kuma Partners ↗</a></li>
          <li><a class="text-steel hover:text-ink" href={site.links.round} {...ext}>The Round ↗</a></li>
          <li><a class="text-steel hover:text-ink" href={site.links.neurodisruptors} {...ext}>Neurodisruptors ↗</a></li>
          {site.links.linkedin && <li><a class="text-steel hover:text-ink" href={site.links.linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn ↗</a></li>}
        </ul>
      </div>
    </div>
    <div class="pb-10 pt-5 hair-t flex flex-col sm:flex-row gap-2 justify-between label">
      <p>© {year} Sven Mulfinger · Barcelona</p>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2">
        <a class="hover:text-ink hover:hair-u" href="/privacy">Privacy Policy</a>
        <a class="hover:text-ink hover:hair-u" href="/legal">Legal Notice</a>
      </nav>
    </div>
  </div>
</footer>
