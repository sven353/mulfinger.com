---
// Colophon-style footer on paper. The credentials line replaces the old proof bar.
import { site } from '../data/site';
const year = new Date().getFullYear();
const ext = { target: '_blank', rel: 'noopener noreferrer' };
import { langs, chrome, type Lang } from '../data/i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const c = chrome[lang];
const en = lang === 'en' ? {} : { hreflang: 'en' };
const here = Astro.url.pathname.replace(/\/?$/, '/');
---
<footer class="mt-auto">
  <div class="container-x">
    <div class="hair-t hair-strong pt-12 pb-10 lg:grid lg:grid-cols-12 lg:gap-x-10">
      <div class="lg:col-span-3">
        <p class="font-display font-semibold text-[1.125rem] text-ink">Sven Mulfinger</p>
        <p class="mt-2 label">{c.brand}</p>
      </div>
      <div class="mt-8 lg:mt-0 lg:col-span-5">
        <p class="reading text-[1.0625rem]! leading-relaxed">
          {c.cred[0]}<span class="text-line-strong" aria-hidden="true"> · </span>{c.cred[1]}<span class="text-line-strong" aria-hidden="true"> · </span>{c.cred[2]}
        </p>
        <p class="mt-2 label">{c.loc}</p>
        {c.enNote && <p class="mt-2 label">{c.enNote}</p>}
      </div>
      <nav aria-label="Footer" class="mt-8 lg:mt-0 lg:col-span-2 text-[0.875rem] max-lg:inline-block max-lg:w-[48%] max-lg:align-top">
        <ul class="space-y-2">
          <li><a class="text-steel hover:text-ink" href="/about" {...en}>{c.nav['/about']}</a></li>
          <li><a class="text-steel hover:text-ink" href="/advisory" {...en}>{c.nav['/advisory']}</a></li>
          <li><a class="text-steel hover:text-ink" href="/#research" {...en}>{c.nav['/#research']}</a></li>
          <li><a class="text-steel hover:text-ink" href="/recommendations" {...en}>{c.nav['/recommendations']}</a></li>
          <li><a class="text-steel hover:text-ink" href={lang === 'en' ? '/contact' : '#contact'}>{c.nav['/contact']}</a></li>
        </ul>
      </nav>
      <div class="mt-8 lg:mt-0 lg:col-span-2 text-[0.875rem] max-lg:inline-block max-lg:w-[48%] max-lg:align-top">
        <ul class="space-y-2">
          <li><a class="text-steel hover:text-ink" href={site.links.kuma} {...ext}>Kuma Partners ↗</a></li>
          <li><a class="text-steel hover:text-ink" href={site.links.round} {...ext}>The Round ↗</a></li>
          <li><a class="text-steel hover:text-ink" href={site.links.neurodisruptors} {...ext}>Neurodisruptors ↗</a></li>
          {site.links.linkedin && <li><a class="text-steel hover:text-ink" href={site.links.linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn ↗</a></li>}
        </ul>
      </div>
    </div>
    <div class="pb-10 pt-5 hair-t flex flex-col sm:flex-row gap-2 justify-between label">
      <p class="sm:order-1">© {year} Sven Mulfinger · Barcelona</p>
      <nav aria-label="Languages" class="flex flex-wrap gap-x-4 gap-y-2 sm:order-2">
        {(Object.keys(langs) as Lang[]).map((l) => (
          <a href={langs[l].path} hreflang={langs[l].tag} lang={langs[l].tag} aria-current={here === langs[l].path ? 'page' : undefined} class:list={['hover:text-ink hover:hair-u', here === langs[l].path && 'text-ink']}>{langs[l].name}</a>
        ))}
      </nav>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2 sm:order-3">
        <a class="hover:text-ink hover:hair-u" href="/privacy" {...en}>{c.privacy}</a>
        <a class="hover:text-ink hover:hair-u" href="/legal" {...en}>{c.legal}</a>
      </nav>
    </div>
  </div>
</footer>
