---
import { badges } from '../data/site';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<section aria-label="Credentials" class:list={['border-y', dark ? 'border-ink-line bg-ink text-white' : 'border-line bg-mist']}>
  <dl class="container-x grid grid-cols-2 lg:grid-cols-4">
    {badges.map((b, i) => (
      <div class:list={[
        'py-7 md:py-9 pr-4',
        i % 2 === 1 && 'pl-4 md:pl-6 border-l',
        i >= 2 && 'border-t lg:border-t-0',
        i === 2 && 'lg:pl-6 lg:border-l',
        dark ? 'border-ink-line' : 'border-line',
      ]}>
        <dt class:list={['label', dark ? 'text-fog' : 'text-steel']}>{String(i + 1).padStart(2, '0')} · {b.label}</dt>
        <dd class="mt-3 text-xl md:text-2xl font-medium tracking-tight">{b.value}</dd>
        <dd class:list={['mt-1 text-sm', dark ? 'text-fog' : 'text-steel']}>{b.note}</dd>
      </div>
    ))}
  </dl>
</section>
