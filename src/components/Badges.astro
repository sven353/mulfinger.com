---
// Full-width proof bar directly beneath the hero.
// Claims come from src/data/site.ts (confirmed list only).
import { badges } from '../data/site';
---
<section aria-label="Credentials" class="border-y border-line bg-mist">
  <dl class="container-x grid sm:grid-cols-3">
    {badges.map((b, i) => (
      <div class:list={[
        'flex items-baseline justify-between gap-6 py-6 sm:block sm:py-10',
        i > 0 && 'border-t border-line sm:border-t-0 sm:border-l sm:pl-8 lg:pl-10',
        i < badges.length - 1 && 'sm:pr-8',
      ]}>
        <dt class="label text-steel sm:mb-4">{b.label}</dt>
        <div class="text-right sm:text-left">
          <dd class="text-xl md:text-[1.7rem] font-medium tracking-tight leading-none">{b.value}</dd>
          <dd class="mt-2 text-sm text-steel">{b.note}</dd>
        </div>
      </div>
    ))}
  </dl>
</section>
