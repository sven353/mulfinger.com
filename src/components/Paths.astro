---
// The three ways to work together, set as a plain list with hairlines (no cards).
// Shared by the homepage and /advisory so both say the same thing.
import { site } from '../data/site';
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---
<ul class="mt-8 border-t border-line">
  <li class="py-7 sm:grid sm:grid-cols-[13rem_1fr] sm:gap-8 border-b border-line">
    <h3 class="text-2xl leading-snug text-ink">1:1 Executive Advisory</h3>
    <div class="mt-2 sm:mt-0">
      <p class="reading">Confidential counsel for the founder or CEO carrying the final call. Two sessions a month for six or twelve months, in Barcelona, Madrid or online, with direct access in between when a decision cannot wait.</p>
      <p class="mt-3 text-[0.9375rem]"><a href="/advisory" class="link">How 1:1 advisory works</a></p>
    </div>
  </li>
  <li class="py-7 sm:grid sm:grid-cols-[13rem_1fr] sm:gap-8 border-b border-line">
    <h3 class="text-2xl leading-snug text-ink">The Round</h3>
    <div class="mt-2 sm:mt-0">
      <p class="reading">A private peer group in Barcelona for founders and CEOs of growing companies. Monthly sessions on live issues with people who carry the same weight. By application or nomination.</p>
      <p class="mt-3 text-[0.9375rem]"><a href={site.links.round} {...ext} class="link">theround.kuma.partners<span class="sr-only"> (opens in a new tab)</span></a></p>
    </div>
  </li>
  <li class="py-7 sm:grid sm:grid-cols-[13rem_1fr] sm:gap-8 border-b border-line">
    <h3 class="text-2xl leading-snug text-ink">Leadership teams</h3>
    <div class="mt-2 sm:mt-0">
      <p class="reading">When the friction sits between executives, the work moves to Kuma Partners, my practice for leadership team offsites, operating models and the 14-Day Leadership Friction Diagnostic, run with partners who have led companies themselves.</p>
      <p class="mt-3 text-[0.9375rem] flex flex-wrap gap-x-6 gap-y-2">
        <a href={site.links.kuma} {...ext} class="link">kuma.partners<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={site.links.offsite} {...ext} class="link">Offsites<span class="sr-only"> (opens in a new tab)</span></a>
      </p>
    </div>
  </li>
</ul>
