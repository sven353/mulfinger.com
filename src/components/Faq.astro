---
// Advisory FAQ (only on /advisory). Each item shows the question and a one-line verdict.
// The deeper context sits in a native <details> (accessible, works without JS).
// Outbound links appear only inside the expanded context.
// FAQPage JSON-LD is emitted in <head> by Seo.astro via the `faq` prop on Layout.
import { faq, segments } from '../data/faq';

interface Props { heading?: string; intro?: string }
const {
  heading = 'Questions leaders ask first.',
  intro = 'Short answers first. Open any item for the full context.',
} = Astro.props;
---
<section id="faq" aria-labelledby="faq-heading" class="scroll-mt-20">
  <div class="container-x">
    <div class="relative py-14 lg:py-20 lg:grid lg:grid-cols-12 lg:gap-x-10">
      <span aria-hidden="true" class="draw absolute inset-x-0 top-0 h-px bg-line-strong"></span>
      <div class="lg:col-span-3">
        <p class="label lg:pt-2 lg:sticky lg:top-10">{faq.length} questions</p>
      </div>
      <div class="mt-3 lg:mt-0 lg:col-span-8 xl:col-span-7">
        <h2 id="faq-heading" class="settle text-[2rem] sm:text-[2.5rem] leading-[1.1] tracking-[-0.012em] text-ink text-balance">{heading}</h2>
        <p class="mt-6 reading max-w-[38rem]">{intro}</p>
        <ol class="mt-8 border-t border-line">
          {faq.map((item, i) => {
            const id = `faq-${i + 1}`;
            return (
              <li class="settle py-7 border-b border-line">
                <h3 id={id} class="text-[1.4rem] sm:text-[1.6rem] leading-snug text-ink">{item.q}</h3>
                <p class="mt-3 reading">{item.verdict}</p>
                <details class="faq-details group mt-4">
                  <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-[0.9375rem] text-accent hover:text-accent-hover [&::-webkit-details-marker]:hidden" aria-describedby={id}>
                    <span class="group-open:hidden">Read the context</span>
                    <span class="hidden group-open:inline">Hide the context</span>
                    <span aria-hidden="true" class="transition-transform duration-200 group-open:rotate-180">↓</span>
                  </summary>
                  <p class="faq-body mt-4 border-l border-line-strong pl-5 reading">
                    {segments(item.body).map((s) =>
                      s.href
                        ? <a href={s.href} target="_blank" rel="noopener noreferrer" class="link">{s.text}<span class="sr-only"> (opens in a new tab)</span></a>
                        : s.text
                    )}
                  </p>
                </details>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* Smooth height expansion where the browser supports it (Chromium 131+); instant elsewhere. */
  @supports selector(::details-content) {
    .faq-details { interpolate-size: allow-keywords; }
    .faq-details::details-content {
      block-size: 0;
      overflow: clip;
      transition: block-size 220ms ease, content-visibility 220ms allow-discrete;
    }
    .faq-details[open]::details-content { block-size: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-details::details-content { transition: none; }
  }
</style>
