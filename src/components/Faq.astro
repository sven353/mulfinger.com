---
// 12-question FAQ. Each item shows the question and a one-line verdict.
// The deeper context sits in a native <details> (accessible, works without JS).
// Outbound links appear only inside the expanded context.
// FAQPage JSON-LD is emitted in <head> by Seo.astro via the `faq` prop on Layout.
import { faq, segments } from '../data/faq';

interface Props { tone?: 'light' | 'mist'; heading?: string; intro?: string }
const {
  tone = 'light',
  heading = 'Questions leaders ask first.',
  intro = 'Short answers first. Open any item for the full context.',
} = Astro.props;
---
<section id="faq" aria-labelledby="faq-heading" class:list={['border-t border-line scroll-mt-16', tone === 'mist' ? 'bg-mist' : 'bg-white']}>
  <div class="container-x py-24 md:py-32 grid md:grid-cols-12 gap-10">
    <div class="md:col-span-4">
      <div class="md:sticky md:top-28">
        <p class="label text-steel">FAQ · {faq.length} questions</p>
        <h2 id="faq-heading" class="mt-5 display text-4xl md:text-5xl text-balance">{heading}</h2>
        <p class="mt-6 text-steel leading-relaxed max-w-xs">{intro}</p>
        <a href="/contact" class="mt-8 hidden md:inline-flex items-center gap-3 bg-ink text-white px-5 py-3 text-sm hover:bg-ink-hover transition-colors">Request strategic diagnostic <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ol class="md:col-span-8 border-t border-ink">
      {faq.map((item, i) => {
        const id = `faq-${i + 1}`;
        return (
          <li class="border-b border-line py-7 md:py-8 grid grid-cols-[2.25rem_1fr] md:grid-cols-[3rem_1fr] gap-x-3">
            <span class="label text-steel pt-1.5" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 id={id} class="text-lg md:text-xl font-semibold tracking-tight leading-snug">{item.q}</h3>
              <p class="mt-3 text-ink/80 leading-relaxed">{item.verdict}</p>
              <details class="faq-details group mt-4">
                <summary class="inline-flex cursor-pointer list-none items-center gap-2.5 text-sm text-steel hover:text-ink transition-colors [&::-webkit-details-marker]:hidden" aria-describedby={id}>
                  <span class="grid size-5 place-items-center border border-line group-open:border-ink transition-colors" aria-hidden="true">
                    <svg class="transition-transform duration-200 group-open:rotate-180" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M2 3.5l3 3 3-3"/></svg>
                  </span>
                  <span class="group-open:hidden">Read context</span>
                  <span class="hidden group-open:inline">Hide context</span>
                </summary>
                <p class="faq-body mt-4 border-l border-ink pl-5 text-steel leading-relaxed max-w-2xl">
                  {segments(item.body).map((s) =>
                    s.href
                      ? <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-ink underline underline-offset-4 decoration-line hover:decoration-ink transition-colors">{s.text}<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">↗</span></a>
                      : s.text
                  )}
                </p>
              </details>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  /* Smooth height expansion where the browser supports it (Chromium 131+); instant elsewhere. */
  @supports selector(::details-content) {
    .faq-details { interpolate-size: allow-keywords; }
    .faq-details::details-content {
      block-size: 0;
      overflow: clip;
      transition: block-size 260ms ease, content-visibility 260ms allow-discrete;
    }
    .faq-details[open]::details-content { block-size: auto; }
  }
  /* Gentle fade and lift for the revealed text, all browsers */
  .faq-details[open] .faq-body { animation: faq-in 260ms ease both; }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .faq-details::details-content { transition: none; }
    .faq-details[open] .faq-body { animation: none; }
  }
</style>
