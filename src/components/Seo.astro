---
import { site } from '../data/site';
import { toPlain, type FaqItem } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'profile';
  faq?: FaqItem[];
}

const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  noindex = false,
  type = 'website',
  faq,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
const sameAs = [site.links.kuma, site.links.neurodisruptors, site.links.linkedin].filter(Boolean);

const services = [
  {
    '@type': 'Service',
    '@id': `${site.url}/#service-1to1`,
    name: '1:1 Executive Advisory',
    serviceType: 'Executive advisory',
    description: 'Confidential thought partnership for founders, CEOs and C-suite leaders carrying the final call. 6 or 12-month retainer with fortnightly sessions, online or in person in Barcelona or Madrid.',
    url: `${site.url}/advisory#one-to-one`,
    provider: { '@id': `${site.url}/#person` },
    areaServed: 'Europe',
    availableLanguage: site.languages,
  },
  {
    '@type': 'Service',
    '@id': `${site.url}/#service-round`,
    name: 'The Round',
    serviceType: 'CEO peer advisory board',
    description: 'Private, curated peer collective for high-growth founders and CEOs, based in Barcelona. Participation by application or peer nomination.',
    url: site.links.round,
    provider: { '@id': `${site.url}/#person` },
    areaServed: 'Barcelona, Europe',
  },
  {
    '@type': 'Service',
    '@id': `${site.url}/#service-kuma`,
    name: 'Leadership team alignment with Kuma Partners',
    serviceType: 'Executive team alignment and strategic offsites',
    description: 'Executive team alignment, decision governance, strategic offsites and the 14-Day Leadership Friction Diagnostic.',
    url: site.links.kuma,
    provider: { '@id': `${site.url}/#kuma` },
    areaServed: 'Europe',
  },
];

const faqLd = faq?.length
  ? {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      url: canonical,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: `${f.verdict} ${toPlain(f.body)}` },
      })),
    }
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      honorificPrefix: 'Dr.',
      url: site.url,
      image: imageUrl,
      jobTitle: 'Strategic Advisor and Executive Coach',
      description: site.description,
      knowsLanguage: site.languages,
      address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
      worksFor: { '@id': `${site.url}/#kuma` },
      affiliation: { '@type': 'CollegeOrUniversity', name: 'IESE Business School', url: 'https://www.iese.edu' },
      knowsAbout: [
        'Executive advisory',
        'Leadership team alignment',
        'Strategic offsites',
        'Decision governance',
        'Neurodivergent leadership',
        'Scale-up leadership',
      ],
      sameAs,
    },
    {
      '@type': 'Organization',
      '@id': `${site.url}/#kuma`,
      name: 'Kuma Partners',
      url: site.links.kuma,
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#advisory`,
      name: 'Sven Mulfinger Strategic Advisory',
      url: site.url,
      provider: { '@id': `${site.url}/#person` },
      founder: { '@id': `${site.url}/#person` },
      areaServed: { '@type': 'Place', name: 'Europe' },
      address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
      availableLanguage: site.languages,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Engagement modes',
        itemListElement: services.map((sv) => ({ '@type': 'Offer', itemOffered: { '@id': sv['@id'] } })),
      },
    },
    ...services,
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      inLanguage: 'en-GB',
      publisher: { '@id': `${site.url}/#person` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#person` },
      inLanguage: 'en-GB',
    },
    ...(faqLd ? [faqLd] : []),
  ],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:locale:alternate" content="es_ES" />
<meta property="og:locale:alternate" content="de_DE" />
<meta property="og:locale:alternate" content="fr_FR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Sven Mulfinger, strategic thought partner to founders and CEOs" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
