---
// One section of the working paper: a quiet note in the left margin, the text in a reading column.
// On small screens the note sits above the heading.
interface Props { id?: string; note: string; heading?: string; headingId?: string; rule?: boolean; class?: string }
const { id, note, heading, headingId, rule = true, class: extra } = Astro.props;
const hid = headingId ?? (id ? `${id}-heading` : undefined);
---
<section id={id} aria-labelledby={heading ? hid : undefined} class:list={['scroll-mt-20', extra]}>
  <div class="container-x">
    <div class:list={['py-14 lg:py-20 lg:grid lg:grid-cols-12 lg:gap-x-10', rule && 'border-t border-line-strong']}>
      <div class="lg:col-span-3">
        <p class="label lg:pt-2">{note}</p>
        <slot name="margin" />
      </div>
      <div class="mt-3 lg:mt-0 lg:col-span-8 xl:col-span-7">
        {heading && <h2 id={hid} class="text-[2rem] sm:text-[2.5rem] leading-[1.1] tracking-[-0.012em] text-ink text-balance">{heading}</h2>}
        <slot />
      </div>
    </div>
  </div>
</section>
