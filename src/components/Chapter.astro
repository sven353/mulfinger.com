---
// One section of the page (direction C, v62): a graphite rule across the grid, the section number and name
// in the left column ("02 / How I think"), the heading and text in the right-hand columns.
// On small screens the name sits above the heading.
interface Props { id?: string; note: string; num?: string; heading?: string; headingId?: string; rule?: boolean; wide?: boolean; tone?: 'paper' | 'sand' | 'dark'; class?: string }
const { id, note, num, heading, headingId, rule = true, wide = false, tone = 'paper', class: extra } = Astro.props;
const hid = headingId ?? (id ? `${id}-heading` : undefined);
---
<section id={id} aria-labelledby={heading ? hid : undefined} class:list={['scroll-mt-20', tone !== 'paper' && `tone-${tone}`, extra]}>
  <div class="container-x">
    <div class:list={['relative lg:grid lg:grid-cols-12 lg:gap-x-6', tone === 'paper' ? 'py-14 lg:py-24' : 'py-16 lg:py-28']}>
      {rule && <span aria-hidden="true" class:list={['draw absolute inset-x-0 h-px hair-t hair-ink', tone === 'paper' ? 'top-0' : 'top-16 lg:top-28']}></span>}
      <div class="lg:col-span-3 pt-4">
        <!-- The section name stays beside the text while you read the chapter -->
        <div class="lg:sticky lg:top-10">
          <p class="secnum">{num && <span>{num} / </span>}{note}</p>
          <slot name="margin" />
        </div>
      </div>
      <div class:list={['mt-6 lg:mt-0 pt-4', wide ? 'lg:col-span-9' : 'lg:col-span-8 xl:col-span-7']}>
        {heading && <h2 id={hid} class="settle display text-[2.1rem] sm:text-[2.75rem] lg:text-[3.1rem] leading-[1.02] text-ink text-balance">{heading}</h2>}
        <slot />
      </div>
    </div>
  </div>
</section>
