---
// Shared opening (direction C, v62): the photograph runs the full width of the window with muted colour,
// then the headline sits below it on the grid, with the subtitle and the button in the right-hand column.
// Used by the homepage and /advisory.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; headingId: string; title: string; body: string; tag: string; pos?: string }
const { src, alt, headingId, title, body, tag, pos = 'object-center' } = Astro.props;
// The photograph is shown as it is: no reveal or zoom animation, so it stays sharp.
---
<section aria-labelledby={headingId} class="relative">
  <div class="relative w-full h-[34svh] min-h-[15rem] sm:h-[48svh] lg:h-[58svh] lg:min-h-[26rem] lg:max-h-[36rem] overflow-hidden bg-mist">
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, 1584, 2172]}
      sizes="100vw"
      format="webp"
      quality={92}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class:list={['hero-photo absolute inset-0 size-full object-cover', pos]}
    />
  </div>
  <div class="container-x pt-8 sm:pt-10 lg:pt-14 pb-14 lg:pb-24">
    <p class="rise label"><span class="font-medium text-accent">{tag.split(' · ')[0]}</span>{tag.includes(' · ') && <> · {tag.split(' · ').slice(1).join(' · ')}</>}</p>
    <div class="mt-5 lg:mt-7 lg:grid lg:grid-cols-12 lg:gap-x-6">
      <h1 id={headingId} class="rise rise-2 display lg:col-span-8 text-[2.6rem] sm:text-[3.6rem] lg:text-[4.4rem] xl:text-[5rem] leading-[0.98] text-ink max-w-[16ch]">{title}</h1>
      <div class="mt-7 lg:mt-0 lg:col-start-10 lg:col-span-3 lg:self-end lg:pb-2">
        <p class="rise rise-3 reading">{body}</p>
        <a href="/contact" class="rise rise-4 mt-7 flex justify-between items-center gap-4 min-h-[3.25rem] bg-ink text-paper px-5 text-[0.9375rem] font-medium hover:bg-ink-hover transition-colors">Start a confidential conversation <span aria-hidden="true">→</span></a>
        <p class="rise rise-4 mt-3 label">I read every message myself. No obligation to continue.</p>
      </div>
    </div>
  </div>
</section>
