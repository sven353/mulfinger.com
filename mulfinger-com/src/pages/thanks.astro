---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you | Sven Mulfinger" noindex>
  <section class="container-x py-32 md:py-44 max-w-3xl">
    <p class="eyebrow">Received</p>
    <h1 class="mt-6 font-serif text-5xl md:text-6xl leading-tight">Thank you. I will read this personally.</h1>
    <p class="mt-6 text-lg text-graphite">You will hear from me within a few working days.</p>
    <a href="/" class="mt-10 inline-block text-sm border-b border-ink pb-1 hover:text-bronze hover:border-bronze">Back to the homepage</a>
  </section>
</Base>
