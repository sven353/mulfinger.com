---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Sven Mulfinger" noindex>
  <section class="container-x py-32 md:py-44 max-w-3xl">
    <p class="eyebrow">404</p>
    <h1 class="mt-6 font-serif text-5xl md:text-6xl leading-tight">This page is not here.</h1>
    <p class="mt-6 text-lg text-graphite">It may have moved when the site was rebuilt.</p>
    <a href="/" class="mt-10 inline-block text-sm border-b border-ink pb-1 hover:text-bronze hover:border-bronze">Go to the homepage</a>
  </section>
</Base>
