---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-paper">
  <div class="container-x py-16 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-serif text-3xl leading-tight">Slow down to speed up.</p>
      <p class="mt-4 text-sm text-paper/60 max-w-sm">Strategic advisory for founders and C-suite leaders. Barcelona, working across Europe in English, Spanish, German and French.</p>
    </div>
    <nav aria-label="Footer" class="md:col-span-3 md:col-start-7 text-sm">
      <p class="eyebrow !text-paper/50">Site</p>
      <ul class="mt-4 space-y-2">
        <li><a class="hover:text-bronze-soft" href="/about">About</a></li>
        <li><a class="hover:text-bronze-soft" href="/advisory">Advisory</a></li>
        <li><a class="hover:text-bronze-soft" href="/#research">Research</a></li>
        <li><a class="hover:text-bronze-soft" href="/#contact">Contact</a></li>
      </ul>
    </nav>
    <div class="md:col-span-3 text-sm">
      <p class="eyebrow !text-paper/50">Elsewhere</p>
      <ul class="mt-4 space-y-2">
        <li><a class="hover:text-bronze-soft" href={site.links.kuma} rel="noopener">Kuma Partners ↗</a></li>
        <li><a class="hover:text-bronze-soft" href={site.links.round} rel="noopener">The Round ↗</a></li>
        <li><a class="hover:text-bronze-soft" href={site.links.neurodisruptors} rel="noopener">Neurodisruptors ↗</a></li>
        {site.links.linkedin && <li><a class="hover:text-bronze-soft" href={site.links.linkedin} rel="noopener me">LinkedIn ↗</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-paper/10">
    <div class="container-x py-6 flex flex-col sm:flex-row gap-2 justify-between text-xs text-paper/50">
      <p>© {year} Sven Mulfinger. All rights reserved.</p>
      <p><a class="hover:text-paper" href="/legal">Legal notice and privacy</a></p>
    </div>
  </div>
</footer>
